                            "GL2C_PERF_SEL_REQ_TO_MISS_QUEUE  :  Number of requests are sent to miss queue. " = 0x38, 
                            "GL2C_PERF_SEL_HIT_PASS_MISS_IN_CLIENT0  :  Number of hit requests passed earlier miss requests in client 0 channel. " = 0x39, 
                            "GL2C_PERF_SEL_HIT_PASS_MISS_IN_CLIENT1  :  Number of hit requests passed earlier miss requests in client 1 channel. " = 0x3a, 
                            "GL2C_PERF_SEL_HIT_PASS_MISS_IN_CLIENT2  :  Number of hit requests passed earlier miss requests in client 2 channel. " = 0x3b, 
                            "GL2C_PERF_SEL_HIT_PASS_MISS_IN_CLIENT3  :  Number of hit requests passed earlier miss requests in client 3 channel. " = 0x3c, 
                            "GL2C_PERF_SEL_HIT_PASS_MISS_IN_CLIENT4  :  Number of hit requests passed earlier miss requests in client 4 channel. " = 0x3d, 
                            "GL2C_PERF_SEL_HIT_PASS_MISS_IN_CLIENT5" = 0x3e, 
                            "GL2C_PERF_SEL_HIT_PASS_MISS_IN_CLIENT6" = 0x3f, 
                            "GL2C_PERF_SEL_HIT_PASS_MISS_IN_CLIENT7" = 0x40, 
                            "GL2C_PERF_SEL_HIT_PASS_MISS_IN_CLIENT8" = 0x41, 
                            "GL2C_PERF_SEL_HIT_PASS_MISS_IN_CLIENT9" = 0x42, 
