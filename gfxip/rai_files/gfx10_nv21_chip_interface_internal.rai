                            "SQ_PERF_SEL_SALU_PIPE_STALL  :  Cycles that SALU math pipeline is stalled due to SGPR-write-back. " = 0x92, 
                            "SQ_PERF_SEL_SMEM_DCACHE_RETURN_CYCLES  :  Cycles that SQC-D$ is returning data to SQ " = 0x93, 
                            "SQ_PERF_SEL_Reserved_21  :  counter removed " = 0x94, 
                            "SQ_PERF_SEL_MSG_BUS_BUSY  :  Cycles in which a valid message (other than token) is on the message bus. (measured in SQG) " = 0x95, 
                            "SQ_PERF_SEL_EXP_REQ_BUS_STALL  :  Cycles in which SQ wants to send an export request but is blocked due the bus already being busy. " = 0x96, 
                            "SQ_PERF_SEL_EXP_REQ0_BUS_BUSY  :  Cycles in which export request bus 0 is busy. (measured in SQG) " = 0x97, 
                            "SQ_PERF_SEL_EXP_REQ1_BUS_BUSY  :  Cycles in which export request bus 1 is busy. (measured in SQG) " = 0x98, 
                            "SQ_PERF_SEL_EXP_BUS0_BUSY  :  Cycles in which export data bus is busy (measured in SQG by looking at
                    export grant.  wave64 grant counts for 2) " = 0x99, 
                            "SQ_PERF_SEL_EXP_BUS1_BUSY  :  Cycles in which export data bus is busy (measured in SQG by looking at
                    export grant.  wave64 grant counts for 2) " = 0x9a, 
                            "SQ_PERF_SEL_Reserved_19  :  counter removed " = 0x9b, 
                            "SQ_PERF_SEL_INST_CACHE_REQ_STALL  :  Number of cycles SQ was stalled from making an instruction request due to SQC's input fifo full " = 0x9c, 
                            "SQ_PERF_SEL_Reserved_22  :  counter removed " = 0x9d, 
                            "SQ_PERF_SEL_Reserved_23  :  counter removed " = 0x9e, 
                            "SQ_PERF_SEL_Reserved_24  :  counter removed " = 0x9f, 
                            "SQ_PERF_SEL_USER0  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 0. {emulated, C2} " = 0xa0, 
                            "SQ_PERF_SEL_USER1  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 1. {emulated, C2} " = 0xa1, 
                            "SQ_PERF_SEL_USER2  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 2. {emulated, C2} " = 0xa2, 
                            "SQ_PERF_SEL_USER3  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 3. {emulated, C2} " = 0xa3, 
