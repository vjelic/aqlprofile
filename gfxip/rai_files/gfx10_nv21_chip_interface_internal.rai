TD_CNTL   <GpuF0Reg:0x9494> <GpuF1Reg:0x9494>   32    {
    SYNC_PHASE_SH  1:0  NUM ;
    FORCE_RESIDENCY_MAP_TO_BE_MAX_FILTER  2:2  ALPHA {"0:  The residency map filter behaves as normal. " = 0x0, 
                            "1:  The residency map filter is forced to be a max filter.  All samples of a pixel are sent as is to the max filter. " = 0x1 }  ;
    DISABLE_SAMPLER_NEG_SCALED_NUM_CLAMP  3:3  ALPHA {"0: Let the formatter clamp to the maximum negative value if it detects the accumulator went beyond the format's range. " = 0x0, 
                            "1: Turn off the formatter's clamping logic regardless if the accumulator went out of the format's range. " = 0x1 }  ;
    SYNC_PHASE_VC_SMX  5:4  NUM ;
    DISABLE_SAMPLER_MAX_NORM_NUM_CLAMP  6:6  ALPHA {"0: Let the formatter clamp normalized numbers to 1.0 if they go above it. " = 0x0, 
                            "1: Turn off the formatter's clamping logic regardless if the normalized number goes out of range. " = 0x1 }  ;
    FORCE_RESIDENCY_MAP_CC_MAX_OF_ALL_SAMPLES  7:7  ALPHA {"0:  The residency map filter chooses the max of the TR and BL samples to generate BR. " = 0x0, 
                            "1:  The residency map filter chooses the max of all the samples to generate BR. " = 0x1 }  ;
    PAD_STALL_EN  8:8  NUM ;
    EXTEND_LDS_STALL  10:9  NUM ;
    LDS_STALL_PHASE_ADJUST  12:11  NUM ;
    PRESERVE_VGPR_ON_UTC_ERROR  13:13  ALPHA {"0:  For sampler and no_filter instructions, write zeroes to VGPR for threads that had a translation error.  For BVH instructions, write ones to VGPR for threads that had a translation error. " = 0x0, 
                            "1:  Do not write any VGPR.  If a UTC error occurs for any thread of an instruction, the VGPRs will not be overridden for the entire instruction. " = 0x1 }  ;
    PRECISION_COMPATIBILITY  15:15  NUM ;
    GATHER4_FLOAT_MODE  16:16  ALPHA {"0: Pass denorm/NaN untouched like mov operation " = 0x0, 
                            "1: Override denorm/NaN as in SAMPLE " = 0x1 }  ;
    FORCE_RT_BVH4_ARBITER_TO_PING_PONG  17:17  ALPHA {"0:  Default mode.  Arbitration is based on the traffic in the separate box and triangle pipelines as well as the input parser. " = 0x0, 
                            "1:  Force the arbiter to ping-pong back and forth between the separate box and triangle pipelines. " = 0x1 }  ;
    LD_FLOAT_MODE  18:18  ALPHA {"Not supported " = 0x0 }  ;
    GATHER4_DX9_MODE  19:19  ALPHA {"0: Return data in DX10 order: (w,z,y,x)=(tl,tr,br,bl) " = 0x0, 
                            "1: Return data in DX9 order: (w,z,y,x)=(tl,br,bl,tr) " = 0x1 }  ;
    DISABLE_POWER_THROTTLE  20:20  ALPHA {"0: Allow CAC to throttle TD during power on " = 0x0, 
                            "1: Ignore CAC stall/throttle " = 0x1 }  ;
    ENABLE_ROUND_TO_ZERO  21:21  ALPHA {"0: Disable RTZ conversion (Default is Round-to-Nearest-Even (RTE)) " = 0x0, 
                            "1: Enable RTZ conversion from FP32 to FP16 (when D16 Mode is Enabled) " = 0x1 }  ;
    DISABLE_ROUND_TO_ZERO_FOR_LARGE_FLOAT_TO_SMALL_FLOAT  22:22  ALPHA {"0: Large-to-small float conversion uses RTZ " = 0x0, 
                            "1: Large-to-small float converstion uses RNE " = 0x1 }  ;
    DISABLE_2BIT_SIGNED_FORMAT  23:23  ALPHA {"0:  Enable 2-bit signed formats. " = 0x0, 
                            "1:  Disable 2-bit signed formats.  2-bit components of formats will be treated as unsigned. " = 0x1 }  ;
    ARBITER_ROUND_ROBIN  24:24  ALPHA {"0:  Interleave no_filter returns between sampler and intersect engine returns. " = 0x0, 
                            "1:  Give the same priority to all 3 of the TD's pipelines. " = 0x1 }  ;
    ARBITER_OLDEST_PRIORITY  25:25  ALPHA {"0:  Ping-pong back and forth between the instruction pipelines.  Instructions can leave the TD out-of-order. " = 0x0, 
                            "1:  Force TD to output all instructions in-order.  Data can still go out-of-order. " = 0x1 }  ;
    DONE_SCOREBOARD_DEPTH  31:26  NUM ;
};

