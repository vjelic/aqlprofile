                            "GL2C_PERF_SEL_CM_DCC_OUT_XFC  :  Indicates when a valid output (per tid/32B). " = 0xf7, 
                            "GL2C_PERF_SEL_CM_DCC_OUT_1x1  :  Indicates a sector would be packed compressed as 1x1 (per sector/64B). " = 0xf8, 
                            "GL2C_PERF_SEL_CM_DCC_OUT_1x2  :  Indicates a sector would be packed compressed as 1x2 (per sector/64B). " = 0xf9, 
                            "GL2C_PERF_SEL_CM_DCC_OUT_2x1  :  Indicates a sector would be packed compressed as 2x1 (per sector/64B). " = 0xfa, 
                            "GL2C_PERF_SEL_CM_DCC_OUT_2x2  :  Indicates a sector would be packed compressed as 2x2 (per sector/64B). " = 0xfb, 
                            "GL2C_PERF_SEL_CM_DCC_OUT_UNCOMP  :  Indicates sector is uncompressed (per sector/64B). " = 0xfc, 
                            "GL2C_PERF_SEL_CM_DCC_OUT_CONST  :  Whole uncompressed block detected as constant (per 256B). " = 0xfd }  ;
    CNTR_MODE  23:20  NUM ;
    PERF_MODE  31:28  ALPHA {"PERFMON_COUNTER_MODE_ACCUM  :  Accumulate increment values over enabled cycles. " = 0x0, 
                            "PERFMON_COUNTER_MODE_ACTIVE_CYCLES  :  Count the number of cycles with a nonzero increment value. " = 0x1, 
                            "PERFMON_COUNTER_MODE_MAX  :  Store the largest increment value received over cycles counted. " = 0x2, 
                            "PERFMON_COUNTER_MODE_DIRTY  :  Record whether a nonzero increment value was ever received. " = 0x3, 
                            "PERFMON_COUNTER_MODE_SAMPLE  :  Just record the latest increment vlaue. " = 0x4, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_FIRST_EVENT  :  Count the cycles since a nonzero increment value. " = 0x5, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_LAST_EVENT  :  Count the cycles since a zero increment value. " = 0x6, 
                            "PERFMON_COUNTER_MODE_CYCLES_GE_HI  :  Count the cycles with an increment greater than or equal to the value in the high bits. " = 0x7, 
                            "PERFMON_COUNTER_MODE_CYCLES_EQ_HI  :  Count the cycles with an increment equal to the value in the high bits. " = 0x8, 
                            "PERFMON_COUNTER_MODE_INACTIVE_CYCLES  :  Count the number of cycles with a zero increment value. " = 0x9, 
                            "PERFMON_COUNTER_MODE_RESERVED  :  This is here just so this is a 4 bit field in case we add modes in the future.  Don't use it. " = 0xf }  ;
};

GL2C_PERFCOUNTER3_SELECT   <GpuF0Reg:0x36e14> <GpuF1Reg:0x36e14>   32    {
    PERF_SEL  9:0  ALPHA {"GL2C_PERF_SEL_NONE  :  Don't count anything. " = 0x0, 
                            "GL2C_PERF_SEL_CYCLE  :  Number of cycles.  Not windowable. " = 0x1, 
                            "GL2C_PERF_SEL_BUSY  :  Number of cycles we have a request pending.  Not windowable. " = 0x2, 
                            "GL2C_PERF_SEL_REQ  :  Number of requests of all types.  This is measured at the tag block.  This may be more than the number of requests arriving at the GL2C, but it is a good indication of the total amount of work that needs to be performed. " = 0x3, 
                            "GL2C_PERF_SEL_VOL_REQ  :  Number of volatile requests.  This is measured at the tag block.  This may be more than the number of requests arriving at the GL2C, but it is a good indication of the total amount of work that needs to be performed. " = 0x4, 
                            "GL2C_PERF_SEL_HIGH_PRIORITY_REQ  :  Number of requests of high priority type.  This is measured at the tag block. " = 0x5, 
                            "GL2C_PERF_SEL_READ  :  Number of read requests, including compressed reads and metadata reads. This is measured at output_fifos block. " = 0x6, 
                            "GL2C_PERF_SEL_WRITE  :  Number of read requests, including compressed reads and metadata reads. This is measured at output_fifos block. " = 0x7, 
                            "GL2C_PERF_SEL_ATOMIC  :  Number of atomic requests of all types. This is measured at output_fifos block. " = 0x8, 
                            "GL2C_PERF_SEL_NOP_ACK  :  Number of NOP_ACK requests, including no_write_ack created by CM. This is measured at output_fifos block. " = 0x9, 
                            "GL2C_PERF_SEL_NOP_RTN0  :  Number of NOP_RTN0 requests. This is measured at output_fifos block. " = 0xa, 
                            "GL2C_PERF_SEL_PROBE  :  Number of probe requests.  Not windowable. " = 0xb, 
                            "GL2C_PERF_SEL_PROBE_ALL  :  Number of external probe requests with with EA_GL2C_preq_all== 1.  Not windowable. " = 0xc, 
                            "GL2C_PERF_SEL_INTERNAL_PROBE  :  Number of self-probes spawned by GL2C for CC writes/atomic operations.  Not windowable. " = 0xd, 
                            "GL2C_PERF_SEL_COMPRESSED_READ_REQ  :  Number of compressed requests. This includes requests that read compressed data(compressed read, cm compressed read and prefetch compressed read).  Metadata requests are not included.  This is measured at the tag block. " = 0xe, 
                            "GL2C_PERF_SEL_METADATA_READ_REQ  :  Number of metadata requests.  This is measured at the tag block. " = 0xf, 
                            "GL2C_PERF_SEL_CLIENT0_REQ  :  Number of cycles client0 sent a request to this GL2C. " = 0x10, 
                            "GL2C_PERF_SEL_CLIENT1_REQ  :  Number of cycles client1 sent a request to this GL2C. " = 0x11, 
                            "GL2C_PERF_SEL_CLIENT2_REQ  :  Number of cycles client2 sent a request to this GL2C. " = 0x12, 
                            "GL2C_PERF_SEL_CLIENT3_REQ  :  Number of cycles client3 sent a request to this GL2C. " = 0x13, 
                            "GL2C_PERF_SEL_CLIENT4_REQ  :  Number of cycles client4 sent a request to this GL2C. " = 0x14, 
                            "GL2C_PERF_SEL_CLIENT5_REQ  :  Unused. " = 0x15, 
                            "GL2C_PERF_SEL_CLIENT6_REQ  :  Unused. " = 0x16, 
                            "GL2C_PERF_SEL_CLIENT7_REQ  :  Unused. " = 0x17, 
                            "GL2C_PERF_SEL_CLIENT8_REQ  :  Unused. " = 0x18, 
                            "GL2C_PERF_SEL_CLIENT9_REQ  :  Unused. " = 0x19, 
                            "GL2C_PERF_SEL_CLIENT10_REQ  :  Unused. " = 0x1a, 
                            "GL2C_PERF_SEL_CLIENT11_REQ  :  Unused. " = 0x1b, 
                            "GL2C_PERF_SEL_CLIENT12_REQ  :  Unused. " = 0x1c, 
                            "GL2C_PERF_SEL_CLIENT13_REQ  :  Unused. " = 0x1d, 
                            "GL2C_PERF_SEL_CLIENT14_REQ  :  Unused. " = 0x1e, 
                            "GL2C_PERF_SEL_CLIENT15_REQ  :  Unused. " = 0x1f, 
                            "GL2C_PERF_SEL_C_RW_S_REQ  :  The number of C_RW_S requests.  This is measured at the tag block. " = 0x20, 
                            "GL2C_PERF_SEL_C_RW_US_REQ  :  The number of C_RW_US requests.  This is measured at the tag block. " = 0x21, 
                            "GL2C_PERF_SEL_C_RO_S_REQ  :  The number of C_RO_S requests.  This is measured at the tag block. " = 0x22, 
                            "GL2C_PERF_SEL_C_RO_US_REQ  :  The number of C_RO_US requests.  This is measured at the tag block. " = 0x23, 
                            "GL2C_PERF_SEL_UC_REQ  :  The number of UnCached requests.  This is measured at the tag block. " = 0x24, 
                            "GL2C_PERF_SEL_LRU_REQ  :  Number of lru requests.  This is measured at the tag block. " = 0x25, 
                            "GL2C_PERF_SEL_STREAM_REQ  :  Number of stream requests.  This is measured at the tag block. " = 0x26, 
                            "GL2C_PERF_SEL_BYPASS_REQ  :  Number of bypass requests.  This is measured at the tag block. " = 0x27, 
                            "GL2C_PERF_SEL_NOA_REQ  :  Number of NOA requests.  This is measured at the tag block. " = 0x28, 
                            "GL2C_PERF_SEL_SHARED_REQ  :  The number of shared requests(Cacheable & C_R*_S & !IO).  This is measured at the tag block. " = 0x29, 
                            "GL2C_PERF_SEL_HIT  :  Number of cache hits. " = 0x2a, 
                            "GL2C_PERF_SEL_MISS  :  Number of cache misses.  UC reads count as misses. " = 0x2b, 
                            "GL2C_PERF_SEL_FULL_HIT  :  Number of full cache sector hits. " = 0x2c, 
                            "GL2C_PERF_SEL_PARTIAL_32B_HIT  :  Number of 32 byte cache sector hits. This measure excludes a full cache sector hit. " = 0x2d, 
                            "GL2C_PERF_SEL_PARTIAL_64B_HIT  :  Number of 64 byte cache sector hits. This measure excludes a full cache sector hit. " = 0x2e, 
                            "GL2C_PERF_SEL_PARTIAL_96B_HIT  :  Number of 96 byte cache sector hits. This measure excludes a full cache sector hit. " = 0x2f, 
                            "GL2C_PERF_SEL_DEWRITE_ALLOCATE_HIT  :  Number of times a read was performed on a cache line that had only been written into before.  This can only occur once for the life of a cache line. " = 0x30, 
                            "GL2C_PERF_SEL_FULLY_WRITTEN_HIT  :  Number of times a 32-byte read from the EA was avoided because the cache sector was already fully written with data.  This can only occur once for the life of a cache sector. " = 0x31, 
                            "GL2C_PERF_SEL_UNCACHED_WRITE  :  Number of uncached write/atomic requests written back to main memory. " = 0x32, 
                            "GL2C_PERF_SEL_WRITEBACK  :  Number of dirty lines written back to main memory. " = 0x33, 
