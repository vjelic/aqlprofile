    CNTR_MODE  23:20  ALPHA {"PERFMON_SPM_MODE_OFF  :  Disable streaming performance counters. " = 0x0, 
                            "PERFMON_SPM_MODE_16BIT_CLAMP  :  16 bit streaming mode with clamp and reset " = 0x1, 
                            "PERFMON_SPM_MODE_16BIT_NO_CLAMP  :  16 bit streaming mode with No clamp and No reset. " = 0x2, 
                            "PERFMON_SPM_MODE_32BIT_CLAMP  :  32 bit streaming mode with clamp and reset " = 0x3, 
                            "PERFMON_SPM_MODE_32BIT_NO_CLAMP  :  32 bit streaming mode with No clamp and No reset. " = 0x4, 
                            "PERFMON_SPM_MODE_RESERVED_5  :  Reserved spm mode. " = 0x5, 
                            "PERFMON_SPM_MODE_RESERVED_6  :  Reserved spm mode. " = 0x6, 
                            "PERFMON_SPM_MODE_RESERVED_7  :  Reserved spm mode. " = 0x7, 
                            "PERFMON_SPM_MODE_TEST_MODE_0  :  Spm test mode 0. " = 0x8, 
                            "PERFMON_SPM_MODE_TEST_MODE_1  :  Spm test mode 1. " = 0x9, 
                            "PERFMON_SPM_MODE_TEST_MODE_2  :  Spm test mode 2. " = 0xa }  ;
    PERF_MODE0  27:24  ALPHA {"PERFMON_COUNTER_MODE_ACCUM  :  Accumulate increment values over enabled cycles. " = 0x0, 
                            "PERFMON_COUNTER_MODE_ACTIVE_CYCLES  :  Count the number of cycles with a nonzero increment value. " = 0x1, 
                            "PERFMON_COUNTER_MODE_MAX  :  Store the largest increment value received over cycles counted. " = 0x2, 
                            "PERFMON_COUNTER_MODE_DIRTY  :  Record whether a nonzero increment value was ever received. " = 0x3, 
                            "PERFMON_COUNTER_MODE_SAMPLE  :  Just record the latest increment vlaue. " = 0x4, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_FIRST_EVENT  :  Count the cycles since a nonzero increment value. " = 0x5, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_LAST_EVENT  :  Count the cycles since a zero increment value. " = 0x6, 
                            "PERFMON_COUNTER_MODE_CYCLES_GE_HI  :  Count the cycles with an increment greater than or equal to the value in the high bits. " = 0x7, 
                            "PERFMON_COUNTER_MODE_CYCLES_EQ_HI  :  Count the cycles with an increment equal to the value in the high bits. " = 0x8, 
                            "PERFMON_COUNTER_MODE_INACTIVE_CYCLES  :  Count the number of cycles with a zero increment value. " = 0x9, 
                            "PERFMON_COUNTER_MODE_RESERVED  :  This is here just so this is a 4 bit field in case we add modes in the future.  Don't use it. " = 0xf }  ;
    PERF_MODE1  31:28  ALPHA {"PERFMON_COUNTER_MODE_ACCUM  :  Accumulate increment values over enabled cycles. " = 0x0, 
                            "PERFMON_COUNTER_MODE_ACTIVE_CYCLES  :  Count the number of cycles with a nonzero increment value. " = 0x1, 
                            "PERFMON_COUNTER_MODE_MAX  :  Store the largest increment value received over cycles counted. " = 0x2, 
                            "PERFMON_COUNTER_MODE_DIRTY  :  Record whether a nonzero increment value was ever received. " = 0x3, 
                            "PERFMON_COUNTER_MODE_SAMPLE  :  Just record the latest increment vlaue. " = 0x4, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_FIRST_EVENT  :  Count the cycles since a nonzero increment value. " = 0x5, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_LAST_EVENT  :  Count the cycles since a zero increment value. " = 0x6, 
                            "PERFMON_COUNTER_MODE_CYCLES_GE_HI  :  Count the cycles with an increment greater than or equal to the value in the high bits. " = 0x7, 
                            "PERFMON_COUNTER_MODE_CYCLES_EQ_HI  :  Count the cycles with an increment equal to the value in the high bits. " = 0x8, 
                            "PERFMON_COUNTER_MODE_INACTIVE_CYCLES  :  Count the number of cycles with a zero increment value. " = 0x9, 
                            "PERFMON_COUNTER_MODE_RESERVED  :  This is here just so this is a 4 bit field in case we add modes in the future.  Don't use it. " = 0xf }  ;
};

GE2_SE_PERFCOUNTER0_SELECT1   <GpuF0Reg:0x362d4> <GpuF1Reg:0x362d4>   32    {
    PERF_SEL2  9:0  ALPHA {"ge_se_cm_reading_stalled  :  the GOG can accept data and the CM should be sending data, but is not " = 0x0, 
                            "ge_se_cm_stalled_by_gog  :  the output fifo to the GOG is full and the CM wants to send data " = 0x1, 
                            "ge_se_cm_stalled_by_gsfetch_done  :  all CM state machines are waiting for gsfetch_done " = 0x2, 
                            "ge_se_ds_cache_hits  :  number of parameter cache hits due to a DS (hardware VS is a GS, so tessellation is enabled with GS disabled) " = 0x3, 
                            "ge_se_ds_prims  :  Number of prims output from the tessellator " = 0x4, 
                            "ge_se_es_done  :  Counts number of SX ES DONES received by the VGT. BC only.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x5, 
                            "ge_se_es_done_latency  :  Total latency ES FLUSHES issued to the SX DONES received.  Divide by ES FLUSHES issued for average latency. BC only.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x6, 
                            "ge_se_es_flush  :  Counts number of ES FLUSH events issues by the VGT.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x7, 
                            "ge_se_es_ring_high_water_mark  :  Records maximum number of ES waves outstanding in the ES ring.  Counter select must be set to MAX mode " = 0x8, 
                            "ge_se_es_thread_groups  :  Count of thread groups issued to the ES (these are Domain Shader Threadgroups).  Sensitive to PERF_SEID_IGNORE_MASK " = 0x9, 
                            "ge_se_esthread_stalled_es_rb_full  :  ES thread sends are stalled because the ES ring buffer is full " = 0xa, 
                            "ge_se_esthread_stalled_spi_bp  :  ES thread is stalled due to back pressure from the SPI " = 0xb, 
                            "ge_se_esvert_stalled_gs_event  :  esvert transfers are stalled because of events " = 0xc, 
                            "ge_se_esvert_stalled_gs_tbl  :  esvert transfers are stalled because of GS table being full " = 0xd, 
                            "ge_se_esvert_stalled_gsprim  :  esvert transfers are stalled because of GS prim interface is full " = 0xe, 
                            "ge_se_gog_busy  :  Counts number of cycles that the GOG block is busy " = 0xf, 
                            "ge_se_gog_out_indx_stalled  :  GOG is stalled by back pressure from the output block " = 0x10, 
                            "ge_se_gog_out_prim_stalled  :  GOG is stalled by back pressure from the output block " = 0x11, 
                            "ge_se_gog_vs_tbl_stalled  :  GOG is stalled because the VS table is full " = 0x12, 
                            "ge_se_gs_cache_hits  :  number of parameter cache hits due to a copy shader (hardware VS when GS is enabled) " = 0x13, 
                            "ge_se_gs_counters_avail_stalled  :  GS thread send is stalled because no counters are available " = 0x14, 
                            "ge_se_gs_done  :  Counts number of GS DONES processed by the VGT.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x15, 
                            "ge_se_gs_done_latency  :  Total latency GS FLUSHES issued to the SX DONES received.  Divide by GS FLUSHES issued for average latency.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x16, 
                            "ge_se_gs_issue_rtr_stalled  :  GS thread send is stalled due to something other than the counters or ring buffer being full " = 0x17, 
                            "ge_se_gs_rb_space_avail_stalled  :  GS thread send is stalled because the GS/VS ring buffer is full " = 0x18, 
                            "ge_se_gs_ring_high_water_mark  :  Records maximum number of GS waves outstanding in the GS ring.  Counter select must be set to MAX mode " = 0x19, 
                            "ge_se_gsprim_stalled_es_tbl  :  gsprim transfers are stalled because ES table is full " = 0x1a, 
                            "ge_se_gsprim_stalled_esvert  :  gsprim transfers are stalled because of ES vert interface is full " = 0x1b, 
                            "ge_se_gsprim_stalled_gs_event  :  gsprim transfers are stalled because of events " = 0x1c, 
                            "ge_se_gsprim_stalled_gs_tbl  :  gsprim transfers are stalled because of GS table being full " = 0x1d, 
                            "ge_se_gsthread_stalled  :  GS thread send is stalled. Inclusive of the 3 counters above.  " = 0x1e, 
                            "ge_se_hs_tfm_stall  :  HS TF Memory stall " = 0x1f, 
                            "ge_se_hs_tgs_active_high_water_mark  :  Records maximum number of active threadgroups.  Counter select must be set to MAX mode " = 0x20, 
                            "ge_se_hs_thread_groups  :  Count of thread groups issued to the HS.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x21, 
                            "ge_se_pa0_clipp_eop  :  number of end of packet transfers (can accompany a valid or null primitive, but not an event) " = 0x22, 
                            "ge_se_pa0_clipp_eopg  :   Counts number of CLIPP EOPG issued by the GE " = 0x23, 
                            "ge_se_pa0_clipp_is_event  :  number of events sent to the PA " = 0x24, 
                            "ge_se_pa0_clipp_new_vtx_vect  :  number of primitives that start a new VS wavefront/vector (used by Parameter Cache logic) " = 0x25, 
                            "ge_se_pa0_clipp_null_prim  :  number of null primitives sent to the PA (these transfers carry information like eop or PC dealloc information) " = 0x26, 
                            "ge_se_pa0_clipp_send  :  number of transfers across the CLIPP interface (primitives, tokens, and events) " = 0x27, 
                            "ge_se_pa0_clipp_send_not_event  :  Counts send on the VGT_PA_clipp interface that are not events " = 0x28, 
                            "ge_se_pa0_clipp_stalled  :  ready to send a CLIPP transfer, but stalled by the PA (means the max number of primitives are in flight). If there are stalls on this interface we don't have a deep enough FIFO to hide VS latency from the start to position export or there is back pressure from downstream. Usually the SC in this case, but sometimes due to clipping. " = 0x29, 
                            "ge_se_pa0_clipp_starved_busy  :  CLIPP interface is starved while the VGT is busy (most accurate with VS only tests since these have the least time between the VGT going busy and the CLIPP receiving work. If looking at counts from a single draw use vgt_perf_vgt_pa_clipp_starved_after_work) " = 0x2a, 
                            "ge_se_pa0_clipp_starved_after_work  :   Counts number of cycles between non-event clipp_send and stop when clipp_send with eop. " = 0x2b, 
                            "ge_se_pa0_clipp_valid_prim  :  Counts send on the VGT_PA_clipp interface that are valid prims " = 0x2c, 
                            "ge_se_pa0_clips_send  :  number of transfers sent across the CLIPS interface (S stands for state data and there is a transfer per draw packet) " = 0x2d, 
                            "ge_se_pa0_clips_stalled  :  ready to send a CLIPS transfer, but stalled by the PA.  If there are stalls here it means the draw calls are really small. " = 0x2e, 
                            "ge_se_pa0_clipv_send  :  number of transfers sent across the clipv interface. V stands for vector as in vertex vector or vertex wave. When the VGT sends a VS wave to the SPI it also sends a clipv transfer to the PA. The PA uses data on this interface to know how many positions to fetch after they are exported from the corresponding VS. " = 0x2f, 
                            "ge_se_pa0_clipv_stalled  :  ready to send a CLIPV transfer, but stalled by the PA. " = 0x30, 
                            "ge_se_pa1_clipp_eop  :  number of end of packet transfers (can accompany a valid or null primitive, but not an event) " = 0x31, 
                            "ge_se_pa1_clipp_eopg  :   Counts number of CLIPP EOPG issued by the GE " = 0x32, 
                            "ge_se_pa1_clipp_is_event  :  number of events sent to the PA " = 0x33, 
                            "ge_se_pa1_clipp_new_vtx_vect  :  number of primitives that start a new VS wavefront/vector (used by Parameter Cache logic) " = 0x34, 
                            "ge_se_pa1_clipp_null_prim  :  number of null primitives sent to the PA (these transfers carry information like eop or PC dealloc information) " = 0x35, 
                            "ge_se_pa1_clipp_send  :  number of transfers across the CLIPP interface (primitives, tokens, and events) " = 0x36, 
                            "ge_se_pa1_clipp_send_not_event  :  Counts send on the VGT_PA_clipp interface that are not events " = 0x37, 
                            "ge_se_pa1_clipp_stalled  :  ready to send a CLIPP transfer, but stalled by the PA (means the max number of primitives are in flight). If there are stalls on this interface we don't have a deep enough FIFO to hide VS latency from the start to position export or there is back pressure from downstream. Usually the SC in this case, but sometimes due to clipping. " = 0x38, 
                            "ge_se_pa1_clipp_starved_busy  :  CLIPP interface is starved while the VGT is busy (most accurate with VS only tests since these have the least time between the VGT going busy and the CLIPP receiving work. If looking at counts from a single draw use vgt_perf_vgt_pa_clipp_starved_after_work) " = 0x39, 
                            "ge_se_pa1_clipp_starved_after_work  :   Counts number of cycles between non-event clipp_send and stop when clipp_send with eop. " = 0x3a, 
                            "ge_se_pa1_clipp_valid_prim  :  Counts send on the VGT_PA_clipp interface that are valid prims " = 0x3b, 
                            "ge_se_pa1_clips_send  :  number of transfers sent across the CLIPS interface (S stands for state data and there is a transfer per draw packet) " = 0x3c, 
                            "ge_se_pa1_clips_stalled  :  ready to send a CLIPS transfer, but stalled by the PA.  If there are stalls here it means the draw calls are really small. " = 0x3d, 
                            "ge_se_pa1_clipv_send  :  number of transfers sent across the clipv interface. V stands for vector as in vertex vector or vertex wave. When the VGT sends a VS wave to the SPI it also sends a clipv transfer to the PA. The PA uses data on this interface to know how many positions to fetch after they are exported from the corresponding VS. " = 0x3e, 
                            "ge_se_pa1_clipv_stalled  :  ready to send a CLIPV transfer, but stalled by the PA. " = 0x3f, 
                            "ge_se_reused_es_indices  :  number of reuse buffer hits when ES is the first stage. i.e. the pipeline is configured to have a VS and GS with no tessellation. " = 0x40, 
                            "ge_se_reused_vs_indices  :  number of reused indices, excluding GS scenario G and tessellation " = 0x41, 
                            "ge_se_sclk_gs_vld  :  Counts number of cycles sclk_gs is valid " = 0x42, 
                            "ge_se_sclk_ngg_vld  :  Counts number of cycles sclk_ngg is valid  " = 0x43, 
                            "ge_se_sclk_te11_vld  :  number of clocks the tessellator is active " = 0x44, 
                            "ge_se_sclk_vr_vld  :  Counts number of cycles sclk_vr is valid  " = 0x45, 
                            "ge_se_spi_esvert_eov  :  number of ES end of vectors (eov can count when valid is low). Vector and wavefront are interchangeable terms. " = 0x46, 
                            "ge_se_spi_esvert_stalled  :  ready to send an ES vert but stalled by the SPI. " = 0x47, 
                            "ge_se_spi_esvert_starved_busy  :  ES vert interface is starved while the VGT is busy " = 0x48, 
                            "ge_se_spi_esvert_valid  :  number of valid ES verts " = 0x49, 
                            "ge_se_spi_eswave_is_event  :  Counts number of events on the eswave interface " = 0x4a, 
                            "ge_se_spi_eswave_send  :  Counts number of eswaves sent " = 0x4b, 
                            "ge_se_spi_gsprim_cont  :  GS primitive continued transfers indicate the number of multi-cycle primitives to SE " = 0x4c, 
                            "ge_se_spi_gsprim_eov  :  number of GS end of vectors (eov can count when valid is low). Vector and wavefront are interchangeable terms. " = 0x4d, 
                            "ge_se_spi_gsprim_stalled  :  Counts the number of clocks the gsprim interface is stalled " = 0x4e, 
                            "ge_se_spi_gsprim_starved_busy  :  GS prim interface is starved while the VGT is busy " = 0x4f, 
                            "ge_se_spi_gsprim_valid  :  number of valid GS prims " = 0x50, 
                            "ge_se_spi_gssubgrp_is_event  :  Counts the number of events on the gssubgrp interface " = 0x51, 
                            "ge_se_spi_gssubgrp_send  :  Counts the number of gssubgrp sends " = 0x52, 
                            "ge_se_spi_hsvert_eov  :  HS vert end of vector is active.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x53, 
                            "ge_se_spi_hsvert_stalled  :  HS vert pipe is stalled.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x54, 
                            "ge_se_spi_hsvert_starved_busy  :  HS vert pipe is starved busy.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x55, 
                            "ge_se_spi_hsvert_valid  :  HS Vert is valid.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x56, 
                            "ge_se_spi_hswave_is_event  :  Counts the number of events on the hswave interface " = 0x57, 
                            "ge_se_spi_hswave_send  :  Counts the number of hswave sends " = 0x58, 
                            "ge_se_spi_lsvert_eov  :  LS vert end of vector is active.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x59, 
                            "ge_se_spi_lsvert_stalled  :  LS vert pipe is stalled.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x5a, 
                            "ge_se_spi_lsvert_starved_busy  :  LS vert pipe is starved busy.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x5b, 
                            "ge_se_spi_lsvert_valid  :  LS Vert is valid.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x5c, 
                            "ge_se_spi_hsvert_fifo_full_stall  :  Counts the number of cycles hsvert_fifo in HS block goes full " = 0x5d, 
                            "ge_se_spi_tgrp_fifo_stall  :  Counts the number of cycles threadgroup FIFO in HS block is not read out " = 0x5e, 
                            "ge_se_spi_vsvert_eov  :  number of VS end of vector transfers. Vector and wavefront are interchangeable terms. " = 0x5f, 
                            "ge_se_spi_vsvert_send  :  number of VS verts, including null EOVs " = 0x60, 
                            "ge_se_spi_vsvert_stalled  :  ready to send a VS vert, but stalled by the SPI " = 0x61, 
                            "ge_se_spi_vsvert_starved_busy  :  VS vert interface is starved while the VGT is busy " = 0x62, 
                            "ge_se_spi_vswave_is_event  :  number of event transfers over the VS wave interface " = 0x63, 
                            "ge_se_spi_vswave_send  :  number of VS wave transfers including events " = 0x64, 
                            "ge_spi_hsgrp_spi_stall  :  threadgroup is ready to go but SPI interface is not rtr " = 0x65, 
                            "ge_se_rcm_indicies_hit  :  Counts the number of indicies hit in the RCM " = 0x66, 
                            "ge_se_vs_cache_hits  :  number of parameter cache hits due to an API VS " = 0x67, 
                            "ge_se_vs_done  :  Counts number of VS DONES received by the VGT.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x68, 
                            "ge_se_vs_table_high_water_mark  :  Records maximum number of VS waves outstanding in the VS table.  Counter select must be set to MAX mode " = 0x69, 
                            "ge_se_vs_thread_groups  :  Count of thread groups issued to the VS (these are Domain Shader Threadgroups).  Sensitive to PERF_SEID_IGNORE_MASK " = 0x6a, 
                            "ge_se_vsvert_api_send  :  number of API VS verts sent across the vsvert interface.  only valid when tessellation and GS are off. " = 0x6b, 
                            "ge_se_vsvert_ds_send  :  number of DS verts sent across the vsvert interface.  only valid when GS is off. " = 0x6c, 
                            "ge_se_wait_for_es_done_stalled  :  GS thread SM is ready to move to the next stage as soon as the ES thread finishes " = 0x6d, 
                            "ge_se_waveid_stalled  :  Number of cycles vs waves are stalled waiting for a eop/eopg sync during the draw part of DispatchDraw. " = 0x6e, 
                            "ge_se_spi_vsvert_valid  :  number of valid VS verts " = 0x6f, 
                            "ge_se_spi_gssubgrp_event_window_active  :  number of cycles the event window is active for a GS subgroup event " = 0x70, 
                            "ge_se_hs_input_stall  :  In gen0 and gen1 BC modes the HS input (TG) FIFO hides the LS latency. In gen2 mode the FIFO serves as a buffer, that breaks the back pressure chain, prior to sending HS waves to the SPI. It is not an important counter for gen2. " = 0x71, 
                            "vgt_se_pa0_clipv_starved_busy  :  PA clipv interface is starved while GE is busy " = 0x72, 
                            "vgt_se_pa0_clipv_firstvert  :  First ClipV vert " = 0x73, 
                            "vgt_se_pa0_clips_starved_busy  :  PA clips interface is starved while GE is busy " = 0x74, 
                            "vgt_se_pa1_clipv_starved_busy  :  PA clipv interface is starved while GE is busy " = 0x75, 
                            "vgt_se_pa1_clipv_firstvert  :  First ClipV vert " = 0x76, 
                            "vgt_se_pa1_clips_starved_busy  :  PA clips interface is starved while GE is busy " = 0x77, 
                            "ge_se_sending_vert_or_prim  :  This is an efficiency counter for GE_SPI transfers. It counts when the GE makes either a vert or a prim transfer to SPI on NGG pipeline " = 0x78, 
                            "ge_se_sclk_input_vld  :  Counts number of cycles sclk_input is valid " = 0x79, 
                            "ge_spi_lswave_fifo_full_stall  :  lswave fifo in HS block is going full. This FIFO keeps a count of number of LSwaves in the threadgroup " = 0x7a, 
                            "ge_spi_hswave_fifo_full_stall  :  hswave fifo in HS block is going full. This FIFO keeps a count of number of HSwaves in the threadgroup " = 0x7b, 
                            "ge_hs_tif_stall  :  Stall on putting entries into HS Threadgroup Interface FIFO. " = 0x7c, 
                            "ge_csb_spi_bp  :  GE cannot send subgroup on PA Control Sideband interface because of backpressure. " = 0x7d, 
                            "ge_ngg_starving_for_pc_grant  :  NGG has a subgroup ready to launch but it is waiting for PC grant. This counter can be used in streaming mode along with the pc_space_zero counter to see if unizfied PC manager is creating serialization in GE " = 0x7e, 
                            "ge_vs_starving_for_pc_grant  :  Legacy side has a VS wave ready to launch but it is waiting for PC grant. This counter can be used in streaming mode along with the pc_space_zero counter to see if unizfied PC manager is creating serialization in GE " = 0x7f, 
                            "ge_strmout_stalled  :  output block waiting for its turn on the streamout bus " = 0x80, 
                            "ge_pa0_csb_eop  :  number of EOPs to PA0 CSB " = 0x81, 
                            "ge_pa1_csb_eop  :  number of EOPs to PA1 CSB " = 0x82, 
                            "ge_ngg_starved_idle  :  number of cycles ngg is starving for work within a draw. This counter is used to calculate ngg prim and vert rate. vert_rate = ge_se_spi_esvert_valid/(ge_esvert_send + ge_ngg_starved_idle + ge_se_spi_esvert_starved_busy + ge_se_spi_esvert_stalled) and prim_rate = ge_se_spi_gsprim_valid/(ge_gsprim_send + ge_ngg_starved_idle + ge_se_spi_gsprim_starved_busy + ge_se_spi_gsprim_stalled) " = 0x83, 
                            "ge_gsprim_send  :  number of sends on GE_SPI_gsprim interface " = 0x84, 
                            "ge_esvert_send  :  number of sends on GE_SPI_esvert interface " = 0x85, 
                            "ge_ngg_starved_after_work  :  number of cycles ngg is starving for work across all draws. This counter is used to calculate ngg prim and vert rate for a series of draw. vert_rate = ge_se_spi_esvert_valid/(ge_esvert_send + ge_ngg_starved_after_work + ge_se_spi_esvert_starved_busy + ge_se_spi_esvert_stalled) and prim_rate = ge_se_spi_gsprim_valid/(ge_gsprim_send + ge_ngg_starved_after_work + ge_se_spi_gsprim_starved_busy + ge_se_spi_gsprim_stalled) " = 0x86, 
                            "ge_ngg_subgrp_fifo_stall  :  NGG stalled on writing into subgroup fifo (fifo is full and we have something to write). " = 0x87, 
                            "ge_ngg_ord_id_req_stall  :  NGG stalled on sending a request to PC Manager. " = 0x88, 
                            "ge_ngg_indx_bus_stall  :  DIST to NGG index bus is stalled (valid and not reading) " = 0x89, 
                            "ge_hs_stall_tfmm_fifo_full  :  TFMM request fifo is full, preventing sending further HS threadgroups. " = 0x8a }  ;
    PERF_SEL3  19:10  ALPHA {"ge_se_cm_reading_stalled  :  the GOG can accept data and the CM should be sending data, but is not " = 0x0, 
                            "ge_se_cm_stalled_by_gog  :  the output fifo to the GOG is full and the CM wants to send data " = 0x1, 
                            "ge_se_cm_stalled_by_gsfetch_done  :  all CM state machines are waiting for gsfetch_done " = 0x2, 
                            "ge_se_ds_cache_hits  :  number of parameter cache hits due to a DS (hardware VS is a GS, so tessellation is enabled with GS disabled) " = 0x3, 
                            "ge_se_ds_prims  :  Number of prims output from the tessellator " = 0x4, 
                            "ge_se_es_done  :  Counts number of SX ES DONES received by the VGT. BC only.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x5, 
                            "ge_se_es_done_latency  :  Total latency ES FLUSHES issued to the SX DONES received.  Divide by ES FLUSHES issued for average latency. BC only.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x6, 
                            "ge_se_es_flush  :  Counts number of ES FLUSH events issues by the VGT.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x7, 
                            "ge_se_es_ring_high_water_mark  :  Records maximum number of ES waves outstanding in the ES ring.  Counter select must be set to MAX mode " = 0x8, 
                            "ge_se_es_thread_groups  :  Count of thread groups issued to the ES (these are Domain Shader Threadgroups).  Sensitive to PERF_SEID_IGNORE_MASK " = 0x9, 
                            "ge_se_esthread_stalled_es_rb_full  :  ES thread sends are stalled because the ES ring buffer is full " = 0xa, 
                            "ge_se_esthread_stalled_spi_bp  :  ES thread is stalled due to back pressure from the SPI " = 0xb, 
                            "ge_se_esvert_stalled_gs_event  :  esvert transfers are stalled because of events " = 0xc, 
                            "ge_se_esvert_stalled_gs_tbl  :  esvert transfers are stalled because of GS table being full " = 0xd, 
                            "ge_se_esvert_stalled_gsprim  :  esvert transfers are stalled because of GS prim interface is full " = 0xe, 
                            "ge_se_gog_busy  :  Counts number of cycles that the GOG block is busy " = 0xf, 
                            "ge_se_gog_out_indx_stalled  :  GOG is stalled by back pressure from the output block " = 0x10, 
                            "ge_se_gog_out_prim_stalled  :  GOG is stalled by back pressure from the output block " = 0x11, 
                            "ge_se_gog_vs_tbl_stalled  :  GOG is stalled because the VS table is full " = 0x12, 
                            "ge_se_gs_cache_hits  :  number of parameter cache hits due to a copy shader (hardware VS when GS is enabled) " = 0x13, 
                            "ge_se_gs_counters_avail_stalled  :  GS thread send is stalled because no counters are available " = 0x14, 
                            "ge_se_gs_done  :  Counts number of GS DONES processed by the VGT.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x15, 
                            "ge_se_gs_done_latency  :  Total latency GS FLUSHES issued to the SX DONES received.  Divide by GS FLUSHES issued for average latency.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x16, 
                            "ge_se_gs_issue_rtr_stalled  :  GS thread send is stalled due to something other than the counters or ring buffer being full " = 0x17, 
                            "ge_se_gs_rb_space_avail_stalled  :  GS thread send is stalled because the GS/VS ring buffer is full " = 0x18, 
                            "ge_se_gs_ring_high_water_mark  :  Records maximum number of GS waves outstanding in the GS ring.  Counter select must be set to MAX mode " = 0x19, 
                            "ge_se_gsprim_stalled_es_tbl  :  gsprim transfers are stalled because ES table is full " = 0x1a, 
                            "ge_se_gsprim_stalled_esvert  :  gsprim transfers are stalled because of ES vert interface is full " = 0x1b, 
                            "ge_se_gsprim_stalled_gs_event  :  gsprim transfers are stalled because of events " = 0x1c, 
                            "ge_se_gsprim_stalled_gs_tbl  :  gsprim transfers are stalled because of GS table being full " = 0x1d, 
                            "ge_se_gsthread_stalled  :  GS thread send is stalled. Inclusive of the 3 counters above.  " = 0x1e, 
                            "ge_se_hs_tfm_stall  :  HS TF Memory stall " = 0x1f, 
                            "ge_se_hs_tgs_active_high_water_mark  :  Records maximum number of active threadgroups.  Counter select must be set to MAX mode " = 0x20, 
                            "ge_se_hs_thread_groups  :  Count of thread groups issued to the HS.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x21, 
                            "ge_se_pa0_clipp_eop  :  number of end of packet transfers (can accompany a valid or null primitive, but not an event) " = 0x22, 
                            "ge_se_pa0_clipp_eopg  :   Counts number of CLIPP EOPG issued by the GE " = 0x23, 
                            "ge_se_pa0_clipp_is_event  :  number of events sent to the PA " = 0x24, 
                            "ge_se_pa0_clipp_new_vtx_vect  :  number of primitives that start a new VS wavefront/vector (used by Parameter Cache logic) " = 0x25, 
                            "ge_se_pa0_clipp_null_prim  :  number of null primitives sent to the PA (these transfers carry information like eop or PC dealloc information) " = 0x26, 
                            "ge_se_pa0_clipp_send  :  number of transfers across the CLIPP interface (primitives, tokens, and events) " = 0x27, 
                            "ge_se_pa0_clipp_send_not_event  :  Counts send on the VGT_PA_clipp interface that are not events " = 0x28, 
                            "ge_se_pa0_clipp_stalled  :  ready to send a CLIPP transfer, but stalled by the PA (means the max number of primitives are in flight). If there are stalls on this interface we don't have a deep enough FIFO to hide VS latency from the start to position export or there is back pressure from downstream. Usually the SC in this case, but sometimes due to clipping. " = 0x29, 
                            "ge_se_pa0_clipp_starved_busy  :  CLIPP interface is starved while the VGT is busy (most accurate with VS only tests since these have the least time between the VGT going busy and the CLIPP receiving work. If looking at counts from a single draw use vgt_perf_vgt_pa_clipp_starved_after_work) " = 0x2a, 
                            "ge_se_pa0_clipp_starved_after_work  :   Counts number of cycles between non-event clipp_send and stop when clipp_send with eop. " = 0x2b, 
                            "ge_se_pa0_clipp_valid_prim  :  Counts send on the VGT_PA_clipp interface that are valid prims " = 0x2c, 
                            "ge_se_pa0_clips_send  :  number of transfers sent across the CLIPS interface (S stands for state data and there is a transfer per draw packet) " = 0x2d, 
                            "ge_se_pa0_clips_stalled  :  ready to send a CLIPS transfer, but stalled by the PA.  If there are stalls here it means the draw calls are really small. " = 0x2e, 
                            "ge_se_pa0_clipv_send  :  number of transfers sent across the clipv interface. V stands for vector as in vertex vector or vertex wave. When the VGT sends a VS wave to the SPI it also sends a clipv transfer to the PA. The PA uses data on this interface to know how many positions to fetch after they are exported from the corresponding VS. " = 0x2f, 
                            "ge_se_pa0_clipv_stalled  :  ready to send a CLIPV transfer, but stalled by the PA. " = 0x30, 
                            "ge_se_pa1_clipp_eop  :  number of end of packet transfers (can accompany a valid or null primitive, but not an event) " = 0x31, 
                            "ge_se_pa1_clipp_eopg  :   Counts number of CLIPP EOPG issued by the GE " = 0x32, 
                            "ge_se_pa1_clipp_is_event  :  number of events sent to the PA " = 0x33, 
                            "ge_se_pa1_clipp_new_vtx_vect  :  number of primitives that start a new VS wavefront/vector (used by Parameter Cache logic) " = 0x34, 
                            "ge_se_pa1_clipp_null_prim  :  number of null primitives sent to the PA (these transfers carry information like eop or PC dealloc information) " = 0x35, 
                            "ge_se_pa1_clipp_send  :  number of transfers across the CLIPP interface (primitives, tokens, and events) " = 0x36, 
                            "ge_se_pa1_clipp_send_not_event  :  Counts send on the VGT_PA_clipp interface that are not events " = 0x37, 
                            "ge_se_pa1_clipp_stalled  :  ready to send a CLIPP transfer, but stalled by the PA (means the max number of primitives are in flight). If there are stalls on this interface we don't have a deep enough FIFO to hide VS latency from the start to position export or there is back pressure from downstream. Usually the SC in this case, but sometimes due to clipping. " = 0x38, 
                            "ge_se_pa1_clipp_starved_busy  :  CLIPP interface is starved while the VGT is busy (most accurate with VS only tests since these have the least time between the VGT going busy and the CLIPP receiving work. If looking at counts from a single draw use vgt_perf_vgt_pa_clipp_starved_after_work) " = 0x39, 
                            "ge_se_pa1_clipp_starved_after_work  :   Counts number of cycles between non-event clipp_send and stop when clipp_send with eop. " = 0x3a, 
                            "ge_se_pa1_clipp_valid_prim  :  Counts send on the VGT_PA_clipp interface that are valid prims " = 0x3b, 
                            "ge_se_pa1_clips_send  :  number of transfers sent across the CLIPS interface (S stands for state data and there is a transfer per draw packet) " = 0x3c, 
                            "ge_se_pa1_clips_stalled  :  ready to send a CLIPS transfer, but stalled by the PA.  If there are stalls here it means the draw calls are really small. " = 0x3d, 
                            "ge_se_pa1_clipv_send  :  number of transfers sent across the clipv interface. V stands for vector as in vertex vector or vertex wave. When the VGT sends a VS wave to the SPI it also sends a clipv transfer to the PA. The PA uses data on this interface to know how many positions to fetch after they are exported from the corresponding VS. " = 0x3e, 
                            "ge_se_pa1_clipv_stalled  :  ready to send a CLIPV transfer, but stalled by the PA. " = 0x3f, 
                            "ge_se_reused_es_indices  :  number of reuse buffer hits when ES is the first stage. i.e. the pipeline is configured to have a VS and GS with no tessellation. " = 0x40, 
                            "ge_se_reused_vs_indices  :  number of reused indices, excluding GS scenario G and tessellation " = 0x41, 
                            "ge_se_sclk_gs_vld  :  Counts number of cycles sclk_gs is valid " = 0x42, 
                            "ge_se_sclk_ngg_vld  :  Counts number of cycles sclk_ngg is valid  " = 0x43, 
                            "ge_se_sclk_te11_vld  :  number of clocks the tessellator is active " = 0x44, 
                            "ge_se_sclk_vr_vld  :  Counts number of cycles sclk_vr is valid  " = 0x45, 
                            "ge_se_spi_esvert_eov  :  number of ES end of vectors (eov can count when valid is low). Vector and wavefront are interchangeable terms. " = 0x46, 
                            "ge_se_spi_esvert_stalled  :  ready to send an ES vert but stalled by the SPI. " = 0x47, 
                            "ge_se_spi_esvert_starved_busy  :  ES vert interface is starved while the VGT is busy " = 0x48, 
                            "ge_se_spi_esvert_valid  :  number of valid ES verts " = 0x49, 
                            "ge_se_spi_eswave_is_event  :  Counts number of events on the eswave interface " = 0x4a, 
                            "ge_se_spi_eswave_send  :  Counts number of eswaves sent " = 0x4b, 
                            "ge_se_spi_gsprim_cont  :  GS primitive continued transfers indicate the number of multi-cycle primitives to SE " = 0x4c, 
                            "ge_se_spi_gsprim_eov  :  number of GS end of vectors (eov can count when valid is low). Vector and wavefront are interchangeable terms. " = 0x4d, 
                            "ge_se_spi_gsprim_stalled  :  Counts the number of clocks the gsprim interface is stalled " = 0x4e, 
                            "ge_se_spi_gsprim_starved_busy  :  GS prim interface is starved while the VGT is busy " = 0x4f, 
                            "ge_se_spi_gsprim_valid  :  number of valid GS prims " = 0x50, 
                            "ge_se_spi_gssubgrp_is_event  :  Counts the number of events on the gssubgrp interface " = 0x51, 
                            "ge_se_spi_gssubgrp_send  :  Counts the number of gssubgrp sends " = 0x52, 
                            "ge_se_spi_hsvert_eov  :  HS vert end of vector is active.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x53, 
                            "ge_se_spi_hsvert_stalled  :  HS vert pipe is stalled.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x54, 
                            "ge_se_spi_hsvert_starved_busy  :  HS vert pipe is starved busy.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x55, 
                            "ge_se_spi_hsvert_valid  :  HS Vert is valid.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x56, 
                            "ge_se_spi_hswave_is_event  :  Counts the number of events on the hswave interface " = 0x57, 
                            "ge_se_spi_hswave_send  :  Counts the number of hswave sends " = 0x58, 
                            "ge_se_spi_lsvert_eov  :  LS vert end of vector is active.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x59, 
                            "ge_se_spi_lsvert_stalled  :  LS vert pipe is stalled.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x5a, 
                            "ge_se_spi_lsvert_starved_busy  :  LS vert pipe is starved busy.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x5b, 
                            "ge_se_spi_lsvert_valid  :  LS Vert is valid.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x5c, 
                            "ge_se_spi_hsvert_fifo_full_stall  :  Counts the number of cycles hsvert_fifo in HS block goes full " = 0x5d, 
                            "ge_se_spi_tgrp_fifo_stall  :  Counts the number of cycles threadgroup FIFO in HS block is not read out " = 0x5e, 
                            "ge_se_spi_vsvert_eov  :  number of VS end of vector transfers. Vector and wavefront are interchangeable terms. " = 0x5f, 
                            "ge_se_spi_vsvert_send  :  number of VS verts, including null EOVs " = 0x60, 
                            "ge_se_spi_vsvert_stalled  :  ready to send a VS vert, but stalled by the SPI " = 0x61, 
                            "ge_se_spi_vsvert_starved_busy  :  VS vert interface is starved while the VGT is busy " = 0x62, 
                            "ge_se_spi_vswave_is_event  :  number of event transfers over the VS wave interface " = 0x63, 
                            "ge_se_spi_vswave_send  :  number of VS wave transfers including events " = 0x64, 
                            "ge_spi_hsgrp_spi_stall  :  threadgroup is ready to go but SPI interface is not rtr " = 0x65, 
                            "ge_se_rcm_indicies_hit  :  Counts the number of indicies hit in the RCM " = 0x66, 
                            "ge_se_vs_cache_hits  :  number of parameter cache hits due to an API VS " = 0x67, 
                            "ge_se_vs_done  :  Counts number of VS DONES received by the VGT.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x68, 
                            "ge_se_vs_table_high_water_mark  :  Records maximum number of VS waves outstanding in the VS table.  Counter select must be set to MAX mode " = 0x69, 
                            "ge_se_vs_thread_groups  :  Count of thread groups issued to the VS (these are Domain Shader Threadgroups).  Sensitive to PERF_SEID_IGNORE_MASK " = 0x6a, 
                            "ge_se_vsvert_api_send  :  number of API VS verts sent across the vsvert interface.  only valid when tessellation and GS are off. " = 0x6b, 
                            "ge_se_vsvert_ds_send  :  number of DS verts sent across the vsvert interface.  only valid when GS is off. " = 0x6c, 
                            "ge_se_wait_for_es_done_stalled  :  GS thread SM is ready to move to the next stage as soon as the ES thread finishes " = 0x6d, 
                            "ge_se_waveid_stalled  :  Number of cycles vs waves are stalled waiting for a eop/eopg sync during the draw part of DispatchDraw. " = 0x6e, 
                            "ge_se_spi_vsvert_valid  :  number of valid VS verts " = 0x6f, 
                            "ge_se_spi_gssubgrp_event_window_active  :  number of cycles the event window is active for a GS subgroup event " = 0x70, 
                            "ge_se_hs_input_stall  :  In gen0 and gen1 BC modes the HS input (TG) FIFO hides the LS latency. In gen2 mode the FIFO serves as a buffer, that breaks the back pressure chain, prior to sending HS waves to the SPI. It is not an important counter for gen2. " = 0x71, 
                            "vgt_se_pa0_clipv_starved_busy  :  PA clipv interface is starved while GE is busy " = 0x72, 
                            "vgt_se_pa0_clipv_firstvert  :  First ClipV vert " = 0x73, 
                            "vgt_se_pa0_clips_starved_busy  :  PA clips interface is starved while GE is busy " = 0x74, 
                            "vgt_se_pa1_clipv_starved_busy  :  PA clipv interface is starved while GE is busy " = 0x75, 
                            "vgt_se_pa1_clipv_firstvert  :  First ClipV vert " = 0x76, 
                            "vgt_se_pa1_clips_starved_busy  :  PA clips interface is starved while GE is busy " = 0x77, 
                            "ge_se_sending_vert_or_prim  :  This is an efficiency counter for GE_SPI transfers. It counts when the GE makes either a vert or a prim transfer to SPI on NGG pipeline " = 0x78, 
                            "ge_se_sclk_input_vld  :  Counts number of cycles sclk_input is valid " = 0x79, 
                            "ge_spi_lswave_fifo_full_stall  :  lswave fifo in HS block is going full. This FIFO keeps a count of number of LSwaves in the threadgroup " = 0x7a, 
                            "ge_spi_hswave_fifo_full_stall  :  hswave fifo in HS block is going full. This FIFO keeps a count of number of HSwaves in the threadgroup " = 0x7b, 
                            "ge_hs_tif_stall  :  Stall on putting entries into HS Threadgroup Interface FIFO. " = 0x7c, 
                            "ge_csb_spi_bp  :  GE cannot send subgroup on PA Control Sideband interface because of backpressure. " = 0x7d, 
                            "ge_ngg_starving_for_pc_grant  :  NGG has a subgroup ready to launch but it is waiting for PC grant. This counter can be used in streaming mode along with the pc_space_zero counter to see if unizfied PC manager is creating serialization in GE " = 0x7e, 
                            "ge_vs_starving_for_pc_grant  :  Legacy side has a VS wave ready to launch but it is waiting for PC grant. This counter can be used in streaming mode along with the pc_space_zero counter to see if unizfied PC manager is creating serialization in GE " = 0x7f, 
                            "ge_strmout_stalled  :  output block waiting for its turn on the streamout bus " = 0x80, 
                            "ge_pa0_csb_eop  :  number of EOPs to PA0 CSB " = 0x81, 
                            "ge_pa1_csb_eop  :  number of EOPs to PA1 CSB " = 0x82, 
                            "ge_ngg_starved_idle  :  number of cycles ngg is starving for work within a draw. This counter is used to calculate ngg prim and vert rate. vert_rate = ge_se_spi_esvert_valid/(ge_esvert_send + ge_ngg_starved_idle + ge_se_spi_esvert_starved_busy + ge_se_spi_esvert_stalled) and prim_rate = ge_se_spi_gsprim_valid/(ge_gsprim_send + ge_ngg_starved_idle + ge_se_spi_gsprim_starved_busy + ge_se_spi_gsprim_stalled) " = 0x83, 
                            "ge_gsprim_send  :  number of sends on GE_SPI_gsprim interface " = 0x84, 
                            "ge_esvert_send  :  number of sends on GE_SPI_esvert interface " = 0x85, 
                            "ge_ngg_starved_after_work  :  number of cycles ngg is starving for work across all draws. This counter is used to calculate ngg prim and vert rate for a series of draw. vert_rate = ge_se_spi_esvert_valid/(ge_esvert_send + ge_ngg_starved_after_work + ge_se_spi_esvert_starved_busy + ge_se_spi_esvert_stalled) and prim_rate = ge_se_spi_gsprim_valid/(ge_gsprim_send + ge_ngg_starved_after_work + ge_se_spi_gsprim_starved_busy + ge_se_spi_gsprim_stalled) " = 0x86, 
                            "ge_ngg_subgrp_fifo_stall  :  NGG stalled on writing into subgroup fifo (fifo is full and we have something to write). " = 0x87, 
                            "ge_ngg_ord_id_req_stall  :  NGG stalled on sending a request to PC Manager. " = 0x88, 
                            "ge_ngg_indx_bus_stall  :  DIST to NGG index bus is stalled (valid and not reading) " = 0x89, 
                            "ge_hs_stall_tfmm_fifo_full  :  TFMM request fifo is full, preventing sending further HS threadgroups. " = 0x8a }  ;
    PERF_MODE2  27:24  ALPHA {"PERFMON_COUNTER_MODE_ACCUM  :  Accumulate increment values over enabled cycles. " = 0x0, 
                            "PERFMON_COUNTER_MODE_ACTIVE_CYCLES  :  Count the number of cycles with a nonzero increment value. " = 0x1, 
                            "PERFMON_COUNTER_MODE_MAX  :  Store the largest increment value received over cycles counted. " = 0x2, 
                            "PERFMON_COUNTER_MODE_DIRTY  :  Record whether a nonzero increment value was ever received. " = 0x3, 
                            "PERFMON_COUNTER_MODE_SAMPLE  :  Just record the latest increment vlaue. " = 0x4, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_FIRST_EVENT  :  Count the cycles since a nonzero increment value. " = 0x5, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_LAST_EVENT  :  Count the cycles since a zero increment value. " = 0x6, 
                            "PERFMON_COUNTER_MODE_CYCLES_GE_HI  :  Count the cycles with an increment greater than or equal to the value in the high bits. " = 0x7, 
                            "PERFMON_COUNTER_MODE_CYCLES_EQ_HI  :  Count the cycles with an increment equal to the value in the high bits. " = 0x8, 
                            "PERFMON_COUNTER_MODE_INACTIVE_CYCLES  :  Count the number of cycles with a zero increment value. " = 0x9, 
                            "PERFMON_COUNTER_MODE_RESERVED  :  This is here just so this is a 4 bit field in case we add modes in the future.  Don't use it. " = 0xf }  ;
    PERF_MODE3  31:28  ALPHA {"PERFMON_COUNTER_MODE_ACCUM  :  Accumulate increment values over enabled cycles. " = 0x0, 
                            "PERFMON_COUNTER_MODE_ACTIVE_CYCLES  :  Count the number of cycles with a nonzero increment value. " = 0x1, 
                            "PERFMON_COUNTER_MODE_MAX  :  Store the largest increment value received over cycles counted. " = 0x2, 
                            "PERFMON_COUNTER_MODE_DIRTY  :  Record whether a nonzero increment value was ever received. " = 0x3, 
                            "PERFMON_COUNTER_MODE_SAMPLE  :  Just record the latest increment vlaue. " = 0x4, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_FIRST_EVENT  :  Count the cycles since a nonzero increment value. " = 0x5, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_LAST_EVENT  :  Count the cycles since a zero increment value. " = 0x6, 
                            "PERFMON_COUNTER_MODE_CYCLES_GE_HI  :  Count the cycles with an increment greater than or equal to the value in the high bits. " = 0x7, 
                            "PERFMON_COUNTER_MODE_CYCLES_EQ_HI  :  Count the cycles with an increment equal to the value in the high bits. " = 0x8, 
                            "PERFMON_COUNTER_MODE_INACTIVE_CYCLES  :  Count the number of cycles with a zero increment value. " = 0x9, 
                            "PERFMON_COUNTER_MODE_RESERVED  :  This is here just so this is a 4 bit field in case we add modes in the future.  Don't use it. " = 0xf }  ;
