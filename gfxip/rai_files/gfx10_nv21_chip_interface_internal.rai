UTCL1_PERFCOUNTER0_SELECT   <GpuF0Reg:0x3758c> <GpuF1Reg:0x3758c>   32    {
    PERF_SEL  9:0  ALPHA {"UTCL1_PERF_SEL_NONE  :  Count nothing " = 0x0, 
                            "UTCL1_PERF_SEL_REQS  :  Number of incoming requests to cache cores " = 0x1, 
                            "UTCL1_PERF_SEL_HITS  :  Number of hits " = 0x2, 
                            "UTCL1_PERF_SEL_MISSES  :  Number Misses " = 0x3, 
                            "UTCL1_PERF_SEL_BYPASS_REQS  :  Number of requests that bypassed the cache " = 0x4, 
                            "UTCL1_PERF_SEL_HIT_INV_FILTER_REQS  :  Number of requests which were forced to miss because they are within the range of an ongoing invalidation " = 0x5, 
                            "UTCL1_PERF_SEL_SMALLK_PAGES  :  Number of PTEs returned from UTCL2 which will be stored with small page size " = 0x6, 
                            "UTCL1_PERF_SEL_BIGK_PAGES  :  Number of PTEs returned from UTCL2 which will be stored with big page size " = 0x7, 
                            "UTCL1_PERF_SEL_MH_RECENT_BUF_HIT  :  Number of hits in the recent buffer of the Miss Handler " = 0x8, 
                            "UTCL1_PERF_SEL_MH_DUPLICATE_DETECT  :  Number of duplicates deteced in the Miss Handler " = 0x9, 
                            "UTCL1_PERF_SEL_UTCL2_REQS  :  Number of requests sent to the UTCL2 " = 0xa, 
                            "UTCL1_PERF_SEL_UTCL2_RET_PERM_FAULT  :  Number of permission faults returned by UTCL2 to UTCL1 " = 0xb, 
                            "UTCL1_PERF_SEL_UTCL2_RET_PRT_FAULT  :  Number of prt faults returned by UTCL2 to UTCL1 " = 0xc, 
                            "UTCL1_PERF_SEL_UTCL2_RET_XNACK_RETRY  :  Number of xnack retrys returned by UTCL2 to UTCL1 " = 0xd, 
                            "UTCL1_PERF_SEL_UTCL2_RET_FAULT  :  Number of faults returned by UTCL2 to UTCL1 " = 0xe, 
                            "UTCL1_PERF_SEL_STALL_UTCL2_CREDITS  :  Number of cycles stalled because not enough UTCL2 credits " = 0xf, 
                            "UTCL1_PERF_SEL_STALL_MH_FULL  :  Number of cycles stalled because Miss Handler is full " = 0x10, 
                            "UTCL1_PERF_SEL_CP_INVREQS  :  Number of invalidations received from CP " = 0x11, 
                            "UTCL1_PERF_SEL_UTCL2_UTCL1_INVREQS  :  Number of invalidations received from UTCL2 " = 0x12, 
                            "UTCL1_PERF_SEL_RANGE_INVREQS  :  Number of range invalidations received " = 0x13, 
                            "UTCL1_PERF_SEL_INV_ALL_VMID_INVREQS  :  Number of INV_ALL or INV_VMID invalidations received " = 0x14 }  ;
    COUNTER_MODE  31:28  ALPHA {"PERFMON_COUNTER_MODE_ACCUM  :  Accumulate increment values over enabled cycles. " = 0x0, 
                            "PERFMON_COUNTER_MODE_ACTIVE_CYCLES  :  Count the number of cycles with a nonzero increment value. " = 0x1, 
                            "PERFMON_COUNTER_MODE_MAX  :  Store the largest increment value received over cycles counted. " = 0x2, 
                            "PERFMON_COUNTER_MODE_DIRTY  :  Record whether a nonzero increment value was ever received. " = 0x3, 
                            "PERFMON_COUNTER_MODE_SAMPLE  :  Just record the latest increment vlaue. " = 0x4, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_FIRST_EVENT  :  Count the cycles since a nonzero increment value. " = 0x5, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_LAST_EVENT  :  Count the cycles since a zero increment value. " = 0x6, 
                            "PERFMON_COUNTER_MODE_CYCLES_GE_HI  :  Count the cycles with an increment greater than or equal to the value in the high bits. " = 0x7, 
                            "PERFMON_COUNTER_MODE_CYCLES_EQ_HI  :  Count the cycles with an increment equal to the value in the high bits. " = 0x8, 
                            "PERFMON_COUNTER_MODE_INACTIVE_CYCLES  :  Count the number of cycles with a zero increment value. " = 0x9, 
                            "PERFMON_COUNTER_MODE_RESERVED  :  This is here just so this is a 4 bit field in case we add modes in the future.  Don't use it. " = 0xf }  ;
};

