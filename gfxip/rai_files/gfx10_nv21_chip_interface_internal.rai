                            "SP_PERF_SEL_VALU_STALL_DUE_LDS_DIR_NOT_READY  :  VALU stall due to LDS direct data is not ready " = 0x1e9, 
                            "SP_PERF_SEL_VALU_STALL_DUE_VGPR_NOT_READY  :  VALU stall due to VGPR gather not ready " = 0x1ea, 
                            "SP_PERF_SEL_VALU_STALL_DUE_DST_STALL  :  VALU stall due to destination cache is stalled " = 0x1eb, 
                            "SP_PERF_SEL_VALU_STALL_DUE_DST_CACHE_WRITE_CONF  :  VALU stall due to destination cache write port conf " = 0x1ec, 
                            "SP_PERF_SEL_VALU_STALL  :  VALU stall happen " = 0x1ed, 
