                            "CB_PERF_SEL_CC_DCC_COMPRESS_RATIO_6TO4  :  From DCC Compressor in Color Cache:  Number of times a sector was compressed as 6:4. " = 0x183, 
                            "CB_PERF_SEL_CC_DCC_COMPRESS_RATIO_6TO5  :  From DCC Compressor in Color Cache:  Number of times a sector was compressed as 6:5. " = 0x184, 
                            "CB_PERF_SEL_CC_DCC_COMPRESS_RATIO_8TO1  :  From DCC Compressor in Color Cache:  Number of times a sector was compressed as 8:1. " = 0x185, 
                            "CB_PERF_SEL_CC_DCC_COMPRESS_RATIO_8TO2  :  From DCC Compressor in Color Cache:  Number of times a sector was compressed as 8:2. " = 0x186, 
                            "CB_PERF_SEL_CC_DCC_COMPRESS_RATIO_8TO3  :  From DCC Compressor in Color Cache:  Number of times a sector was compressed as 8:3. " = 0x187, 
                            "CB_PERF_SEL_CC_DCC_COMPRESS_RATIO_8TO4  :  From DCC Compressor in Color Cache:  Number of times a sector was compressed as 8:4. " = 0x188, 
                            "CB_PERF_SEL_CC_DCC_COMPRESS_RATIO_8TO5  :  From DCC Compressor in Color Cache:  Number of times a sector was compressed as 8:5. " = 0x189, 
                            "CB_PERF_SEL_CC_DCC_COMPRESS_RATIO_8TO6  :  From DCC Compressor in Color Cache:  Number of times a sector was compressed as 8:6. " = 0x18a, 
                            "CB_PERF_SEL_CC_DCC_COMPRESS_RATIO_8TO7  :  From DCC Compressor in Color Cache:  Number of times a sector was compressed as 8:7. " = 0x18b, 
                            "CB_PERF_SEL_RBP_EXPORT_8PIX_LIT_BOTH  :  Number of 8PIX quad transfers that had both quads lit. " = 0x18c, 
                            "CB_PERF_SEL_RBP_EXPORT_8PIX_LIT_LEFT  :  Number of 8PIX quad transfers that had only the left quad lit. " = 0x18d, 
