GE2_SE_PERFCOUNTER0_SELECT   <GpuF0Reg:0x362d0> <GpuF1Reg:0x362d0>   32    {
    PERF_SEL0  9:0  ALPHA {"ge_se_cm_reading_stalled  :  the GOG can accept data and the CM should be sending data, but is not " = 0x0, 
                            "ge_se_cm_stalled_by_gog  :  the output fifo to the GOG is full and the CM wants to send data " = 0x1, 
                            "ge_se_cm_stalled_by_gsfetch_done  :  all CM state machines are waiting for gsfetch_done " = 0x2, 
                            "ge_se_ds_cache_hits  :  number of parameter cache hits due to a DS (hardware VS is a GS, so tessellation is enabled with GS disabled) " = 0x3, 
                            "ge_se_ds_prims  :  Number of prims output from the tessellator " = 0x4, 
                            "ge_se_es_done  :  Counts number of SX ES DONES received by the VGT. BC only.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x5, 
                            "ge_se_es_done_latency  :  Total latency ES FLUSHES issued to the SX DONES received.  Divide by ES FLUSHES issued for average latency. BC only.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x6, 
                            "ge_se_es_flush  :  Counts number of ES FLUSH events issues by the VGT.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x7, 
                            "ge_se_es_ring_high_water_mark  :  Records maximum number of ES waves outstanding in the ES ring.  Counter select must be set to MAX mode " = 0x8, 
                            "ge_se_es_thread_groups  :  Count of thread groups issued to the ES (these are Domain Shader Threadgroups).  Sensitive to PERF_SEID_IGNORE_MASK " = 0x9, 
                            "ge_se_esthread_stalled_es_rb_full  :  ES thread sends are stalled because the ES ring buffer is full " = 0xa, 
                            "ge_se_esthread_stalled_spi_bp  :  ES thread is stalled due to back pressure from the SPI " = 0xb, 
                            "ge_se_esvert_stalled_gs_event  :  esvert transfers are stalled because of events " = 0xc, 
                            "ge_se_esvert_stalled_gs_tbl  :  esvert transfers are stalled because of GS table being full " = 0xd, 
                            "ge_se_esvert_stalled_gsprim  :  esvert transfers are stalled because of GS prim interface is full " = 0xe, 
                            "ge_se_gog_busy  :  Counts number of cycles that the GOG block is busy " = 0xf, 
                            "ge_se_gog_out_indx_stalled  :  GOG is stalled by back pressure from the output block " = 0x10, 
                            "ge_se_gog_out_prim_stalled  :  GOG is stalled by back pressure from the output block " = 0x11, 
                            "ge_se_gog_vs_tbl_stalled  :  GOG is stalled because the VS table is full " = 0x12, 
                            "ge_se_gs_cache_hits  :  number of parameter cache hits due to a copy shader (hardware VS when GS is enabled) " = 0x13, 
                            "ge_se_gs_counters_avail_stalled  :  GS thread send is stalled because no counters are available " = 0x14, 
                            "ge_se_gs_done  :  Counts number of GS DONES processed by the VGT.  Sensitive to PERF_SEID_IGNORE_MASK " = 0x15, 
