                            "RLC_PERF_SEL_GRBM_INTERRUPT  :  3: GRBM interrupt: count on every interrupt response back from RLC to GRBM " = 0x3, 
                            "RLC_PERF_SEL_SPM_INTERRUPT  :  4: SPM interrupt: count on every interrupt response back from RLC to SPM module within RLC " = 0x4, 
                            "RLC_PERF_SEL_IH_INTERRUPT  :  5: IH interrupt: count on every interrupt successfully forwarded to Interrup Handler Block " = 0x5, 
