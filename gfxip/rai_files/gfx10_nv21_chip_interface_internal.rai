// === ASIC REGISTER DEFINITIONS ===

SECTION_START BLOCK_INFO

BLOCK_NAME = "ATS";
DESCRIPTION = "Address Translation Cache (ATC)";
// RELEASE = "<unknown>";

SECTION_END

SECTION_START BLOCK_REGISTERS
ATHUB_ATS_MODE_CNTL   <GpuF0Reg:0x3000> <GpuF1Reg:0x3000>   32    {
    HOST_TRANS_ENABLE  0:0  NUM ;
    CONSOLE_IOV_ENABLE  1:1  NUM ;
};

ATHUB_SHARED_VIRT_RESET_REQ   <GpuF0Reg:0x3004> <GpuF1Reg:0x3004>   32    {
    VF  30:0  NUM ;
    PF  31:31  ALPHA {" " = 0x0, 
                            "reset the physical function " = 0x1 }  ;
};

ATHUB_SHARED_ACTIVE_FCN_ID   <GpuF0Reg:0x3008> <GpuF1Reg:0x3008>   32    {
    VFID  4:0  NUM ;
    VF  31:31  ALPHA {"physical function " = 0x0, 
                            "virtualization function " = 0x1 }  ;
};

ATC_ATS_CNTL   <GpuF0Reg:0x300c> <GpuF1Reg:0x300c>   32    {
    DISABLE_ATC  0:0  NUM ;
    DISABLE_PRI  1:1  NUM ;
    DISABLE_PASID  2:2  NUM ;
    CREDITS_ATS_RPB  13:8  NUM ;
    DEBUG_ECO  19:16  NUM ;
    INVALIDATION_LOG_KEEP_ORDER  20:20  NUM ;
    TRANS_LOG_KEEP_ORDER  21:21  NUM ;
    TRANS_EXE_RETURN  23:22  NUM ;
    GUEST_TRANS_MISS_MODE  24:24  NUM ;
    KEEP_VMID_BUSY_BY_INTR  25:25  NUM ;
};

ATC_ATS_DEBUG   <GpuF0Reg:0x3010> <GpuF1Reg:0x3010>   32    {
    INVALIDATE_ALL  0:0  NUM W;
    IDENT_RETURN  1:1  NUM ;
    ADDRESS_TRANSLATION_REQUEST_WRITE_PERMS  2:2  NUM ;
    TRANS_REQUESTS_USE_RELAXED_ORDERING  4:4  NUM ;
    PAGE_REQUESTS_USE_RELAXED_ORDERING  5:5  NUM ;
    PRIV_BIT  6:6  NUM ;
    EXE_BIT  7:7  NUM ;
    PAGE_REQUEST_PERMS  8:8  NUM ;
    UNTRANSLATED_ONLY_REQUESTS_CARRY_SIZE  9:9  NUM ;
    DISABLE_INVALIDATION_ON_ED_SWITCH  10:10  NUM ;
    TRANS_REQ_EXE_OVERWRITE  13:11  NUM ;
    DISALLOW_ERR_TO_DONE  14:14  NUM ;
    IGNORE_FED  15:15  NUM ;
    INVALIDATION_REQUESTS_DISALLOWED_WHEN_ATC_IS_DISABLED  16:16  NUM ;
    DISABLE_INVALIDATE_PER_RANGE  17:17  NUM ;
    DISABLE_INVALIDATE_PER_DOMAIN  18:18  NUM ;
    DISABLE_VMID0_PASID_MAPPING  19:19  NUM ;
    DISABLE_INVALIDATION_ON_WORLD_SWITCH  20:20  NUM ;
    ENABLE_INVALIDATION_ON_VIRTUALIZATION_ENTRY_AND_EXIT  21:21  NUM ;
    DISABLE_MULTIPLE_INVALIDATIONS  22:22  NUM ;
    DROP_PAGE_REQUEST_WHEN_FULL  23:23  NUM ;
    EFFECTIVE_TRANS_WORK_QUEUE_SIZE  26:24  NUM ;
    EFFECTIVE_PR_WORK_QUEUE_SIZE  30:27  NUM ;
    DISABLE_VMID16_PASID_MAPPING  31:31  NUM ;
};

ATC_ATS_FAULT_DEBUG   <GpuF0Reg:0x3014> <GpuF1Reg:0x3014>   32    {
    ALLOW_SUBSEQUENT_FAULT_STATUS_ADDR_UPDATES  0:0  NUM ;
    CLEAR_FAULT_STATUS_ADDR  1:1  ALPHA {"normal operation " = 0x0, 
                            "clear status and addr register one-shot " = 0x1 }  W;
};

ATC_ATS_FAULT_CNTL   <GpuF0Reg:0x3018> <GpuF1Reg:0x3018>   32    {
    FAULT_REGISTER_LOG  8:0  NUM ;
    FAULT_INTERRUPT_TABLE  18:10  NUM ;
    FAULT_CRASH_TABLE  28:20  NUM ;
};

ATC_ATS_DEFAULT_PAGE_LOW   <GpuF0Reg:0x301c> <GpuF1Reg:0x301c>   32    {
    DEFAULT_PAGE  31:0  NUM ;
};

ATC_TRANS_FAULT_RSPCNTRL   <GpuF0Reg:0x3020> <GpuF1Reg:0x3020>   32    {
    VMID0  0:0  NUM ;
    VMID1  1:1  NUM ;
    VMID2  2:2  NUM ;
    VMID3  3:3  NUM ;
    VMID4  4:4  NUM ;
    VMID5  5:5  NUM ;
    VMID6  6:6  NUM ;
    VMID7  7:7  NUM ;
    VMID8  8:8  NUM ;
    VMID9  9:9  NUM ;
    VMID10  10:10  NUM ;
    VMID11  11:11  NUM ;
    VMID12  12:12  NUM ;
    VMID13  13:13  NUM ;
    VMID14  14:14  NUM ;
    VMID15  15:15  NUM ;
    VMID16  16:16  NUM ;
    VMID17  17:17  NUM ;
    VMID18  18:18  NUM ;
    VMID19  19:19  NUM ;
    VMID20  20:20  NUM ;
    VMID21  21:21  NUM ;
    VMID22  22:22  NUM ;
    VMID23  23:23  NUM ;
    VMID24  24:24  NUM ;
    VMID25  25:25  NUM ;
    VMID26  26:26  NUM ;
    VMID27  27:27  NUM ;
    VMID28  28:28  NUM ;
    VMID29  29:29  NUM ;
    VMID30  30:30  NUM ;
    VMID31  31:31  NUM ;
};

ATHUB_MISC_CNTL   <GpuF0Reg:0x3024> <GpuF1Reg:0x3024>   32    {
    CG_OFFDLY  5:0  NUM ;
    CG_ENABLE  6:6  ALPHA {"always on sclk " = 0x0, 
                            "use clock gating " = 0x1 }  ;
    CG_MEM_LS_ENABLE  7:7  ALPHA {"disable LS of memory " = 0x0, 
                            "enable LS of memory " = 0x1 }  ;
    PG_ENABLE  8:8  ALPHA {"always power on " = 0x0, 
                            "power on/powern off switch " = 0x1 }  ;
    PG_OFFDLY  14:9  NUM ;
    ALWAYS_BUSY  15:15  NUM ;
    CG_STATUS  16:16  NUM R;
    PG_STATUS  17:17  NUM R;
    RPB_BUSY  18:18  NUM R;
    XPB_BUSY  19:19  NUM R;
    ATS_BUSY  20:20  NUM R;
    SDPNCS_BUSY  21:21  NUM R;
    DFPORT_BUSY  22:22  NUM R;
    SWITCH_CNTL  23:23  NUM ;
};

ATHUB_MEM_POWER_LS   <GpuF0Reg:0x3028> <GpuF1Reg:0x3028>   32    {
    LS_SETUP  5:0  NUM ;
