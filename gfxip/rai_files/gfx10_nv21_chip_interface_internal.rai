                            "SP_PERF_SEL_PERF_MEM_WR_CNT  :  VGPR write cnt " = 0x1ef, 
                            "SP_PERF_SEL_PERF_THREAD_REDUNDANT  :  Threads inside one macc4 have the same inputs " = 0x1f0, 
                            "SP_PERF_SEL_PERF_OP_W_1_PASS  :  SP is executing 1 pass instruction " = 0x1f1, 
                            "SP_PERF_SEL_PERF_OP_W_2_PASS  :  SP is executing 2 pass instruction " = 0x1f2, 
                            "SP_PERF_SEL_PERF_OP_W_4_PASS  :  SP is executing 4 pass instruction " = 0x1f3, 
                            "SP_PERF_SEL_PERF_OP_W_16_PASS  :  SP is executing 16 pass instruction " = 0x1f4, 
                            "SP_PERF_SEL_PERF_COEXEC  :  Trans coexec happened " = 0x1f5, 
                            "SP_PERF_SEL_PERF_ACTIVE_THREAD  :  Number of active threads out of 32 " = 0x1f6, 
                            "SP_PERF_SEL_PERF_ALL_ACTIVE  :  All the threads are active " = 0x1f7, 
                            "SP_PERF_SEL_PERF_ZERO_P_ZERO  :  Zero input for multiplier(FP instructions) " = 0x1f8, 
                            "SP_PERF_SEL_PERF_TRANS_OP  :  SP is executing trans instruction(trans_f16/32/64) " = 0x1f9, 
                            "SP_PERF_SEL_PERF_OP_W_MAD  :  SP is executing MAD instruction(MAD/FMA/INTERP/MADMIX_F16/32) " = 0x1fa, 
                            "SP_PERF_SEL_PERF_OP_W_MUL  :  SP is executing MUL instruction(MUL_F16/32) " = 0x1fb, 
                            "SP_PERF_SEL_PERF_OP_W_ADD  :  SP is executing ADD instruction(ADD_F16/32) " = 0x1fc, 
                            "SP_PERF_SEL_DUMMY_LAST  :  Just a placeholding enum to indicate the end of SP's performance counter space. This enum cannot be used. " = 0x1ff }  ;
    SPM_MODE  23:20  ALPHA {"PERFMON_SPM_MODE_OFF  :  Disable streaming performance counters. " = 0x0, 
                            "PERFMON_SPM_MODE_16BIT_CLAMP  :  16 bit streaming mode with clamp and reset " = 0x1, 
                            "PERFMON_SPM_MODE_16BIT_NO_CLAMP  :  16 bit streaming mode with No clamp and No reset. " = 0x2, 
                            "PERFMON_SPM_MODE_32BIT_CLAMP  :  32 bit streaming mode with clamp and reset " = 0x3, 
                            "PERFMON_SPM_MODE_32BIT_NO_CLAMP  :  32 bit streaming mode with No clamp and No reset. " = 0x4, 
                            "PERFMON_SPM_MODE_RESERVED_5  :  Reserved spm mode. " = 0x5, 
                            "PERFMON_SPM_MODE_RESERVED_6  :  Reserved spm mode. " = 0x6, 
                            "PERFMON_SPM_MODE_RESERVED_7  :  Reserved spm mode. " = 0x7, 
                            "PERFMON_SPM_MODE_TEST_MODE_0  :  Spm test mode 0. " = 0x8, 
                            "PERFMON_SPM_MODE_TEST_MODE_1  :  Spm test mode 1. " = 0x9, 
                            "PERFMON_SPM_MODE_TEST_MODE_2  :  Spm test mode 2. " = 0xa }  ;
    PERF_MODE  31:28  ALPHA {"PERFMON_COUNTER_MODE_ACCUM  :  Accumulate increment values over enabled cycles. " = 0x0, 
                            "PERFMON_COUNTER_MODE_ACTIVE_CYCLES  :  Count the number of cycles with a nonzero increment value. " = 0x1, 
                            "PERFMON_COUNTER_MODE_MAX  :  Store the largest increment value received over cycles counted. " = 0x2, 
                            "PERFMON_COUNTER_MODE_DIRTY  :  Record whether a nonzero increment value was ever received. " = 0x3, 
                            "PERFMON_COUNTER_MODE_SAMPLE  :  Just record the latest increment vlaue. " = 0x4, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_FIRST_EVENT  :  Count the cycles since a nonzero increment value. " = 0x5, 
                            "PERFMON_COUNTER_MODE_CYCLES_SINCE_LAST_EVENT  :  Count the cycles since a zero increment value. " = 0x6, 
                            "PERFMON_COUNTER_MODE_CYCLES_GE_HI  :  Count the cycles with an increment greater than or equal to the value in the high bits. " = 0x7, 
                            "PERFMON_COUNTER_MODE_CYCLES_EQ_HI  :  Count the cycles with an increment equal to the value in the high bits. " = 0x8, 
                            "PERFMON_COUNTER_MODE_INACTIVE_CYCLES  :  Count the number of cycles with a zero increment value. " = 0x9, 
                            "PERFMON_COUNTER_MODE_RESERVED  :  This is here just so this is a 4 bit field in case we add modes in the future.  Don't use it. " = 0xf }  ;
};

SQ_PERFCOUNTER11_SELECT   <GpuF0Reg:0x3672c> <GpuF1Reg:0x3672c>   32    {
    PERF_SEL  8:0  ALPHA {"SQ_PERF_SEL_NONE  :  Don't count anything. Perf counter is disabled. " = 0x0, 
                            "SQ_PERF_SEL_ACCUM_PREV  :  For counter N, increment by the value of counter N-1. " = 0x1, 
                            "SQ_PERF_SEL_CYCLES  :  Total Clock cycles. {nondeterministic, global} " = 0x2, 
                            "SQ_PERF_SEL_BUSY_CYCLES  :  Clock cycles while any SQs in SE reporting busy. {nondeterministic, global, C2} " = 0x3, 
                            "SQ_PERF_SEL_WAVES  :  Count number of waves sent to SQs. {emulated, global, C1} " = 0x4, 
                            "SQ_PERF_SEL_WAVES_32  :  Count number of wave32s sent to SQs. {emulated, global, C1} " = 0x5, 
                            "SQ_PERF_SEL_WAVES_64  :  Count number of waves64s sent to SQs. {emulated, global, C1} " = 0x6, 
                            "SQ_PERF_SEL_LEVEL_WAVES  :  Track the aggregated number of waves over certain period of time, Set next
                    counter to ACCUM_PREV and divide by SQ_PERF_SEL_WAVES for average wave life
                    cycle.  {level, global, C1} " = 0x7, 
                            "SQ_PERF_SEL_ITEMS  :  Number of valid work items in SQs. {emulated, global, C1} " = 0x8, 
                            "SQ_PERF_SEL_WAVE32_ITEMS  :  Number of valid wave32 work items in SQs. {emulated, global, C1} " = 0x9, 
                            "SQ_PERF_SEL_WAVE64_ITEMS  :  Number of valid wave64 work items in SQs. {emulated, global, C1} " = 0xa, 
                            "SQ_PERF_SEL_QUADS  :  Number of completely or partially covered pixel quads in SQs, note: not all
                    kinds of quads.  {emulated, global, C1} " = 0xb, 
                            "SQ_PERF_SEL_EVENTS  :  Number of events sent to SQs.  {unwindowed, emulated, global} " = 0xc, 
                            "SQ_PERF_SEL_WAVES_EQ_64  :  Count number of waves with exactly 64 active items sent to SQs. {emulated, global, C1} " = 0xd, 
                            "SQ_PERF_SEL_WAVES_LT_64  :  Count number of waves with <64 active items sent to SQs. {emulated, global, C1} " = 0xe, 
                            "SQ_PERF_SEL_WAVES_LT_48  :  Count number of waves with <48 active items sent to SQs. {emulated, global, C1} " = 0xf, 
                            "SQ_PERF_SEL_WAVES_LT_32  :  Count number of waves sent <32 active items sent to SQs. {emulated, global, C1} " = 0x10, 
                            "SQ_PERF_SEL_WAVES_LT_16  :  Count number of waves sent <16 active items sent to SQs. {emulated, global, C1} " = 0x11, 
                            "SQ_PERF_SEL_WAVES_RESTORED  :  Count number of context-restored waves sent to SQs. {emulated, global} " = 0x12, 
                            "SQ_PERF_SEL_WAVES_SAVED  :  Count number of context-saved waves sent to SQs. {emulated, global} " = 0x13, 
                            "SQ_PERF_SEL_MSG  :  Number of messages sent, of all types (not including end-program).
                    {nondeterministic, unwindowed, global} " = 0x14, 
                            "SQ_PERF_SEL_MSG_GSCNT  :  Number of GSCNT messages.  {emulated, unwindowed, global} " = 0x15, 
                            "SQ_PERF_SEL_MSG_INTERRUPT  :  Number of interrupt messages.  {emulated, unwindowed, global} " = 0x16, 
                            "SQ_PERF_SEL_Reserved_1  :  counter removed " = 0x17, 
                            "SQ_PERF_SEL_Reserved_2  :  counter removed " = 0x18, 
                            "SQ_PERF_SEL_Reserved_3  :  counter removed " = 0x19, 
                            "SQ_PERF_SEL_WAVE_CYCLES  :  Number of clock cycles spent by waves in the SQs.  Incremented by # of
                    living (valid) waves each cycle.  {nondeterministic, C1} " = 0x1a, 
                            "SQ_PERF_SEL_WAVE_READY  :  Number of clock cycles waves were ready to execute the next instruction.
                    Incremented by # of waves ready to issue an instruction each cycle.  This
                    READY counter will be equal to the sum of: WAIT_INST_* (arb stall) + INST_*
                    (issuing) or INST_WAVE32.  {nondeterministic, C1} " = 0x1b, 
                            "SQ_PERF_SEL_WAIT_INST_ANY  :  Number of clock cycles spent waiting for any instruction issue.  In units
                    of cycles.  {nondeterministic} " = 0x1c, 
