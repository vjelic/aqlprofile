                            "ge_ngg_indx_bus_stall  :  DIST to NGG index bus is stalled (valid and not reading) " = 0x89, 
                            "ge_hs_stall_tfmm_fifo_full  :  TFMM request fifo is full, preventing sending further HS threadgroups. " = 0x8a }  ;
