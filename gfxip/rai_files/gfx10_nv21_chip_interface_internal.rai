ATC_PERFCOUNTER0_CFG   <GpuF0Reg:0x3040> <GpuF1Reg:0x3040>   32    {
    PERF_SEL  7:0  NUM ;
    PERF_SEL_END  15:8  NUM ;
    PERF_MODE  27:24  ALPHA {"PERFMON_COUNTER_MODE_ACCUM: Accumulate increment values over enabled cycles. " = 0x0, 
                            "RESERVE " = 0x1, 
                            "PERFMON_COUNTER_MODE_MAX: Store the largest increment value received. " = 0x2, 
                            " " = 0x3, 
                            " " = 0x4, 
                            " " = 0x5, 
                            " " = 0x6, 
                            "PERFMON_COUNTER_MODE_CYCLES_GE_HI: Count the cycles with an increment greater than or equal to the value ATC_PERFCOUNTER_HI.COMPARE_VALUE " = 0x7, 
                            "PERFMON_COUNTER_MODE_CYCLES_EQ_HI: Count the cycles with an increment equal to the value ATC_PERFCOUNTER_HI.COMPARE_VALUE. " = 0x8, 
                            " " = 0x9, 
                            " " = 0xa, 
                            " " = 0xb, 
                            " " = 0xc, 
                            "PERFMON_COUNTER_MODE_STATISTICAL_LATENCY_GE_HI: Count the number of transactions whose latency is greater than or equal to the value ATC_PERFCOUNTER_HI.COMPARE_VALUE. PERF_SEL indicates the start and PERF_SEL_END indicates the end. " = 0xd, 
                            "PERFMON_COUNTER_MODE_STATISTICAL_MAX_LATENCY: Count the maximum latency of a start or end pair seen by the performance counter. PERF_SEL indicates the start and PERF_SEL_END indicates the end. These are considered statistical because it is only possible to track the latency of a single transaction at a time. Over time we hope to see the start or end pair for a transactions that is closest to the longest. " = 0xe, 
                            "PERFMON_COUNTER_MODE_STATISTICAL_MIN_LATENCY: Count the minimum latency of a start or end pair seen by the performance counter. PERF_SEL indicates the start and PERF_SEL_END indicates the end. These are considered statistical because it is only possible to track the latency of a single transaction at a time. Over time we hope to see the start end pair for a transaction that is closest to the shortest. When using this mode, program the counter result register ATC_PERFOCUNTER_LO to the maximum value before enabling counting. " = 0xf }  ;
    ENABLE  28:28  NUM ;
    CLEAR  29:29  NUM W;
};

