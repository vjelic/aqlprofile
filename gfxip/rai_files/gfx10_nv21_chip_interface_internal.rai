                            "ge_se_pa1_clipv_stalled  :  ready to send a CLIPV transfer, but stalled by the PA. " = 0x3f, 
                            "ge_se_reused_es_indices  :  number of reuse buffer hits when ES is the first stage. i.e. the pipeline is configured to have a VS and GS with no tessellation. " = 0x40, 
