                            "ge_pa1_csb_eop  :  number of EOPs to PA1 CSB " = 0x82, 
                            "ge_ngg_starved_idle  :  number of cycles ngg is starving for work within a draw. This counter is used to calculate ngg prim and vert rate. vert_rate = ge_se_spi_esvert_valid/(ge_esvert_send + ge_ngg_starved_idle + ge_se_spi_esvert_starved_busy + ge_se_spi_esvert_stalled) and prim_rate = ge_se_spi_gsprim_valid/(ge_gsprim_send + ge_ngg_starved_idle + ge_se_spi_gsprim_starved_busy + ge_se_spi_gsprim_stalled) " = 0x83, 
                            "ge_gsprim_send  :  number of sends on GE_SPI_gsprim interface " = 0x84, 
                            "ge_esvert_send  :  number of sends on GE_SPI_esvert interface " = 0x85, 
                            "ge_ngg_starved_after_work  :  number of cycles ngg is starving for work across all draws. This counter is used to calculate ngg prim and vert rate for a series of draw. vert_rate = ge_se_spi_esvert_valid/(ge_esvert_send + ge_ngg_starved_after_work + ge_se_spi_esvert_starved_busy + ge_se_spi_esvert_stalled) and prim_rate = ge_se_spi_gsprim_valid/(ge_gsprim_send + ge_ngg_starved_after_work + ge_se_spi_gsprim_starved_busy + ge_se_spi_gsprim_stalled) " = 0x86, 
                            "ge_ngg_subgrp_fifo_stall  :  NGG stalled on writing into subgroup fifo (fifo is full and we have something to write). " = 0x87, 
                            "ge_ngg_ord_id_req_stall  :  NGG stalled on sending a request to PC Manager. " = 0x88, 
                            "ge_ngg_indx_bus_stall  :  DIST to NGG index bus is stalled (valid and not reading) " = 0x89, 
                            "ge_hs_stall_tfmm_fifo_full  :  TFMM request fifo is full, preventing sending further HS threadgroups. " = 0x8a }  ;
