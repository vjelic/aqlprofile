SQ_PERFCOUNTER2_SELECT   <GpuF0Reg:0x36708> <GpuF1Reg:0x36708>   32    {
    PERF_SEL  8:0  ALPHA {"SQ_PERF_SEL_NONE  :  Don't count anything. Perf counter is disabled. " = 0x0, 
                            "SQ_PERF_SEL_ACCUM_PREV  :  For counter N, increment by the value of counter N-1. " = 0x1, 
                            "SQ_PERF_SEL_CYCLES  :  Total Clock cycles. {nondeterministic, global} " = 0x2, 
                            "SQ_PERF_SEL_BUSY_CYCLES  :  Clock cycles while any SQs in SE reporting busy. {nondeterministic, global, C2} " = 0x3, 
                            "SQ_PERF_SEL_WAVES  :  Count number of waves sent to SQs. {emulated, global, C1} " = 0x4, 
                            "SQ_PERF_SEL_WAVES_32  :  Count number of wave32s sent to SQs. {emulated, global, C1} " = 0x5, 
                            "SQ_PERF_SEL_WAVES_64  :  Count number of waves64s sent to SQs. {emulated, global, C1} " = 0x6, 
                            "SQ_PERF_SEL_LEVEL_WAVES  :  Track the aggregated number of waves over certain period of time, Set next
                    counter to ACCUM_PREV and divide by SQ_PERF_SEL_WAVES for average wave life
                    cycle.  {level, global, C1} " = 0x7, 
                            "SQ_PERF_SEL_ITEMS  :  Number of valid work items in SQs. {emulated, global, C1} " = 0x8, 
                            "SQ_PERF_SEL_WAVE32_ITEMS  :  Number of valid wave32 work items in SQs. {emulated, global, C1} " = 0x9, 
                            "SQ_PERF_SEL_WAVE64_ITEMS  :  Number of valid wave64 work items in SQs. {emulated, global, C1} " = 0xa, 
                            "SQ_PERF_SEL_QUADS  :  Number of completely or partially covered pixel quads in SQs, note: not all
                    kinds of quads.  {emulated, global, C1} " = 0xb, 
                            "SQ_PERF_SEL_EVENTS  :  Number of events sent to SQs.  {unwindowed, emulated, global} " = 0xc, 
                            "SQ_PERF_SEL_WAVES_EQ_64  :  Count number of waves with exactly 64 active items sent to SQs. {emulated, global, C1} " = 0xd, 
                            "SQ_PERF_SEL_WAVES_LT_64  :  Count number of waves with <64 active items sent to SQs. {emulated, global, C1} " = 0xe, 
                            "SQ_PERF_SEL_WAVES_LT_48  :  Count number of waves with <48 active items sent to SQs. {emulated, global, C1} " = 0xf, 
                            "SQ_PERF_SEL_WAVES_LT_32  :  Count number of waves sent <32 active items sent to SQs. {emulated, global, C1} " = 0x10, 
                            "SQ_PERF_SEL_WAVES_LT_16  :  Count number of waves sent <16 active items sent to SQs. {emulated, global, C1} " = 0x11, 
                            "SQ_PERF_SEL_WAVES_RESTORED  :  Count number of context-restored waves sent to SQs. {emulated, global} " = 0x12, 
                            "SQ_PERF_SEL_WAVES_SAVED  :  Count number of context-saved waves sent to SQs. {emulated, global} " = 0x13, 
                            "SQ_PERF_SEL_MSG  :  Number of messages sent, of all types (not including end-program).
                    {nondeterministic, unwindowed, global} " = 0x14, 
                            "SQ_PERF_SEL_MSG_GSCNT  :  Number of GSCNT messages.  {emulated, unwindowed, global} " = 0x15, 
                            "SQ_PERF_SEL_MSG_INTERRUPT  :  Number of interrupt messages.  {emulated, unwindowed, global} " = 0x16, 
                            "SQ_PERF_SEL_Reserved_1  :  counter removed " = 0x17, 
                            "SQ_PERF_SEL_Reserved_2  :  counter removed " = 0x18, 
                            "SQ_PERF_SEL_Reserved_3  :  counter removed " = 0x19, 
                            "SQ_PERF_SEL_WAVE_CYCLES  :  Number of clock cycles spent by waves in the SQs.  Incremented by # of
                    living (valid) waves each cycle.  {nondeterministic, C1} " = 0x1a, 
                            "SQ_PERF_SEL_WAVE_READY  :  Number of clock cycles waves were ready to execute the next instruction.
                    Incremented by # of waves ready to issue an instruction each cycle.  This
                    READY counter will be equal to the sum of: WAIT_INST_* (arb stall) + INST_*
                    (issuing) or INST_WAVE32.  {nondeterministic, C1} " = 0x1b, 
                            "SQ_PERF_SEL_WAIT_INST_ANY  :  Number of clock cycles spent waiting for any instruction issue.  In units
                    of cycles.  {nondeterministic} " = 0x1c, 
                            "SQ_PERF_SEL_WAIT_INST_VALU  :  Number of clock cycles spent waiting for VALU instrution issue.  In units
                    of cycles.  {nondeterministic, C1} " = 0x1d, 
                            "SQ_PERF_SEL_WAIT_INST_SCA  :  Number of clock cycles spent waiting for SALU or SMEM instruction issue.
                    In units of cycles.  {nondeterministic, C1} " = 0x1e, 
                            "SQ_PERF_SEL_WAIT_INST_LDS  :  Number of clock cycles spent waiting for LDS (indexed) instruction issue.
                    In units of cycles.  {nondeterministic, C1} " = 0x1f, 
                            "SQ_PERF_SEL_WAIT_INST_TEX  :  Number of clock cycles spent waiting for TEX (TA) instruction issue.  In
                    units of cycles.  {nondeterministic, C1} " = 0x20, 
                            "SQ_PERF_SEL_WAIT_INST_FLAT  :  Number of clock cycles spent waiting for flat instruction issue.  In units
                    of cycles.  {nondeterministic, C2} " = 0x21, 
                            "SQ_PERF_SEL_WAIT_INST_VMEM  :  Sum of wait_inst_tex + wait_inst_flat + wait_inst_lds {nondeterministic} " = 0x22, 
                            "SQ_PERF_SEL_WAIT_INST_EXP_GDS  :  Number of clock cycles spent waiting for EXPORT or GDS instruction issue.
                    In units of cycles.  {nondeterministic, C1} " = 0x23, 
                            "SQ_PERF_SEL_WAIT_INST_BR_MSG  :  Number of clock cycles spent waiting for BRANCH or SENDMSG instruction
                    issue.  In units of cycles.  {nondeterministic, C1} " = 0x24, 
                            "SQ_PERF_SEL_WAIT_ANY  :  Number of clock cycles spent waiting for anything. {nondeterministic, C1} " = 0x25, 
