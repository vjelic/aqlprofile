                            "SQ_PERF_SEL_USER5  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 5. {emulated, C2} " = 0xa5, 
                            "SQ_PERF_SEL_USER6  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 6. {emulated, C2} " = 0xa6, 
                            "SQ_PERF_SEL_USER7  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 7. {emulated, C2} " = 0xa7, 
                            "SQ_PERF_SEL_USER8  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 8. {emulated, C2} " = 0xa8, 
                            "SQ_PERF_SEL_USER9  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 9. {emulated, C2} " = 0xa9, 
                            "SQ_PERF_SEL_USER10  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 10. {emulated, C2} " = 0xaa, 
                            "SQ_PERF_SEL_USER11  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 11. {emulated, C2} " = 0xab, 
                            "SQ_PERF_SEL_USER12  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 12. {emulated, C2} " = 0xac, 
                            "SQ_PERF_SEL_USER13  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 13. {emulated, C2} " = 0xad, 
                            "SQ_PERF_SEL_USER14  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 14. {emulated, C2} " = 0xae, 
                            "SQ_PERF_SEL_USER15  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 15. {emulated, C2} " = 0xaf, 
                            "SQ_PERF_SEL_USER_LEVEL0  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 0. {level, emulated, C2} " = 0xb0, 
                            "SQ_PERF_SEL_USER_LEVEL1  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 1. {level, emulated, C2} " = 0xb1, 
                            "SQ_PERF_SEL_USER_LEVEL2  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 2. {level, emulated, C2} " = 0xb2, 
                            "SQ_PERF_SEL_USER_LEVEL3  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 3. {level, emulated, C2} " = 0xb3, 
                            "SQ_PERF_SEL_USER_LEVEL4  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 4. {level, emulated, C2} " = 0xb4, 
                            "SQ_PERF_SEL_USER_LEVEL5  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 5. {level, emulated, C2} " = 0xb5, 
                            "SQ_PERF_SEL_USER_LEVEL6  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 6. {level, emulated, C2} " = 0xb6, 
                            "SQ_PERF_SEL_USER_LEVEL7  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 7. {level, emulated, C2} " = 0xb7, 
                            "SQ_PERF_SEL_USER_LEVEL8  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 8. {level, emulated, C2} " = 0xb8, 
                            "SQ_PERF_SEL_USER_LEVEL9  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 9. {level, emulated, C2} " = 0xb9, 
                            "SQ_PERF_SEL_USER_LEVEL10  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 10. {level, emulated, C2} " = 0xba, 
                            "SQ_PERF_SEL_USER_LEVEL11  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 11. {level, emulated, C2} " = 0xbb, 
                            "SQ_PERF_SEL_USER_LEVEL12  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 12. {level, emulated, C2} " = 0xbc, 
                            "SQ_PERF_SEL_USER_LEVEL13  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 13. {level, emulated, C2} " = 0xbd, 
                            "SQ_PERF_SEL_USER_LEVEL14  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 14. {level, emulated, C2} " = 0xbe, 
                            "SQ_PERF_SEL_USER_LEVEL15  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 15. {level, emulated, C2} " = 0xbf, 
                            "SQ_PERF_SEL_VALU_RETURN_SDST  :  Count the number of VALU instructions issued which return data to the SQ
                    (EXEC or SGPR/VCC).  This is also
                    equal to the number of dwords sent from SP to SQ. {emulated} " = 0xc0, 
                            "SQ_PERF_SEL_VMEM_VGPR_READ_STALLED_BY_EXPORT  :  Number of times VMEM vgpr read is stalled by export instruction due to bank conflict " = 0xc1, 
                            "SQ_PERF_SEL_INSTS_VALU_TRANS  :  Number transcendental VALU instructions issued {emulated} " = 0xc2, 
                            "SQ_PERF_SEL_DUMMY_END  :  Just a placeholding enum to indicate the end of real SQ performance counter.  Not a real performance counter. " = 0xc3, 
                            "SQ_PERF_SEL_DUMMY_LAST  :  Just a placeholding enum to separate SQ from SQC/SQG counters. Not a real performance counter. " = 0xff }  ;
    DIV1  31:31  NUM ;
};

SQ_LB_CTR_SEL1   <GpuF0Reg:0x8e78> <GpuF1Reg:0x8e78>   32    {
    SEL2  7:0  ALPHA {"SQ_PERF_SEL_NONE  :  Don't count anything. Perf counter is disabled. " = 0x0, 
                            "SQ_PERF_SEL_ACCUM_PREV  :  For counter N, increment by the value of counter N-1. " = 0x1, 
                            "SQ_PERF_SEL_CYCLES  :  Total Clock cycles. {nondeterministic, global} " = 0x2, 
                            "SQ_PERF_SEL_BUSY_CYCLES  :  Clock cycles while any SQs in SE reporting busy. {nondeterministic, global, C2} " = 0x3, 
                            "SQ_PERF_SEL_WAVES  :  Count number of waves sent to SQs. {emulated, global, C1} " = 0x4, 
                            "SQ_PERF_SEL_WAVES_32  :  Count number of wave32s sent to SQs. {emulated, global, C1} " = 0x5, 
                            "SQ_PERF_SEL_WAVES_64  :  Count number of waves64s sent to SQs. {emulated, global, C1} " = 0x6, 
                            "SQ_PERF_SEL_LEVEL_WAVES  :  Track the aggregated number of waves over certain period of time, Set next
                    counter to ACCUM_PREV and divide by SQ_PERF_SEL_WAVES for average wave life
                    cycle.  {level, global, C1} " = 0x7, 
                            "SQ_PERF_SEL_ITEMS  :  Number of valid work items in SQs. {emulated, global, C1} " = 0x8, 
                            "SQ_PERF_SEL_WAVE32_ITEMS  :  Number of valid wave32 work items in SQs. {emulated, global, C1} " = 0x9, 
                            "SQ_PERF_SEL_WAVE64_ITEMS  :  Number of valid wave64 work items in SQs. {emulated, global, C1} " = 0xa, 
                            "SQ_PERF_SEL_QUADS  :  Number of completely or partially covered pixel quads in SQs, note: not all
                    kinds of quads.  {emulated, global, C1} " = 0xb, 
                            "SQ_PERF_SEL_EVENTS  :  Number of events sent to SQs.  {unwindowed, emulated, global} " = 0xc, 
                            "SQ_PERF_SEL_WAVES_EQ_64  :  Count number of waves with exactly 64 active items sent to SQs. {emulated, global, C1} " = 0xd, 
                            "SQ_PERF_SEL_WAVES_LT_64  :  Count number of waves with <64 active items sent to SQs. {emulated, global, C1} " = 0xe, 
                            "SQ_PERF_SEL_WAVES_LT_48  :  Count number of waves with <48 active items sent to SQs. {emulated, global, C1} " = 0xf, 
                            "SQ_PERF_SEL_WAVES_LT_32  :  Count number of waves sent <32 active items sent to SQs. {emulated, global, C1} " = 0x10, 
                            "SQ_PERF_SEL_WAVES_LT_16  :  Count number of waves sent <16 active items sent to SQs. {emulated, global, C1} " = 0x11, 
                            "SQ_PERF_SEL_WAVES_RESTORED  :  Count number of context-restored waves sent to SQs. {emulated, global} " = 0x12, 
                            "SQ_PERF_SEL_WAVES_SAVED  :  Count number of context-saved waves sent to SQs. {emulated, global} " = 0x13, 
                            "SQ_PERF_SEL_MSG  :  Number of messages sent, of all types (not including end-program).
                    {nondeterministic, unwindowed, global} " = 0x14, 
                            "SQ_PERF_SEL_MSG_GSCNT  :  Number of GSCNT messages.  {emulated, unwindowed, global} " = 0x15, 
                            "SQ_PERF_SEL_MSG_INTERRUPT  :  Number of interrupt messages.  {emulated, unwindowed, global} " = 0x16, 
                            "SQ_PERF_SEL_Reserved_1  :  counter removed " = 0x17, 
                            "SQ_PERF_SEL_Reserved_2  :  counter removed " = 0x18, 
                            "SQ_PERF_SEL_Reserved_3  :  counter removed " = 0x19, 
                            "SQ_PERF_SEL_WAVE_CYCLES  :  Number of clock cycles spent by waves in the SQs.  Incremented by # of
                    living (valid) waves each cycle.  {nondeterministic, C1} " = 0x1a, 
                            "SQ_PERF_SEL_WAVE_READY  :  Number of clock cycles waves were ready to execute the next instruction.
                    Incremented by # of waves ready to issue an instruction each cycle.  This
                    READY counter will be equal to the sum of: WAIT_INST_* (arb stall) + INST_*
                    (issuing) or INST_WAVE32.  {nondeterministic, C1} " = 0x1b, 
                            "SQ_PERF_SEL_WAIT_INST_ANY  :  Number of clock cycles spent waiting for any instruction issue.  In units
                    of cycles.  {nondeterministic} " = 0x1c, 
                            "SQ_PERF_SEL_WAIT_INST_VALU  :  Number of clock cycles spent waiting for VALU instrution issue.  In units
                    of cycles.  {nondeterministic, C1} " = 0x1d, 
                            "SQ_PERF_SEL_WAIT_INST_SCA  :  Number of clock cycles spent waiting for SALU or SMEM instruction issue.
                    In units of cycles.  {nondeterministic, C1} " = 0x1e, 
                            "SQ_PERF_SEL_WAIT_INST_LDS  :  Number of clock cycles spent waiting for LDS (indexed) instruction issue.
                    In units of cycles.  {nondeterministic, C1} " = 0x1f, 
                            "SQ_PERF_SEL_WAIT_INST_TEX  :  Number of clock cycles spent waiting for TEX (TA) instruction issue.  In
                    units of cycles.  {nondeterministic, C1} " = 0x20, 
                            "SQ_PERF_SEL_WAIT_INST_FLAT  :  Number of clock cycles spent waiting for flat instruction issue.  In units
                    of cycles.  {nondeterministic, C2} " = 0x21, 
                            "SQ_PERF_SEL_WAIT_INST_VMEM  :  Sum of wait_inst_tex + wait_inst_flat + wait_inst_lds {nondeterministic} " = 0x22, 
                            "SQ_PERF_SEL_WAIT_INST_EXP_GDS  :  Number of clock cycles spent waiting for EXPORT or GDS instruction issue.
                    In units of cycles.  {nondeterministic, C1} " = 0x23, 
                            "SQ_PERF_SEL_WAIT_INST_BR_MSG  :  Number of clock cycles spent waiting for BRANCH or SENDMSG instruction
                    issue.  In units of cycles.  {nondeterministic, C1} " = 0x24, 
                            "SQ_PERF_SEL_WAIT_ANY  :  Number of clock cycles spent waiting for anything. {nondeterministic, C1} " = 0x25, 
                            "SQ_PERF_SEL_WAIT_CNT_ANY  :  Number of clock cycles spent waiting for any counter.  In units of cycles.
                    {nondeterministic, C1} " = 0x26, 
                            "SQ_PERF_SEL_WAIT_CNT_VMVS  :  Number of clock cycles spent waiting for VM or VS counter.  In units of
                    cycles.  {nondeterministic, C1} " = 0x27, 
                            "SQ_PERF_SEL_WAIT_CNT_LGKM  :  Number of clock cycles spent waiting for LGKM counter.  In units of cycles.
                    {nondeterministic, C1} " = 0x28, 
                            "SQ_PERF_SEL_WAIT_CNT_EXP  :  Number of clock cycles spent waiting for EXP counter.  In units of cycles.
                    {nondeterministic, C1} " = 0x29, 
                            "SQ_PERF_SEL_WAIT_TTRACE  :  Number of clock cycles spent waiting for thread trace stalls.
                    {nondeterministic, C1} " = 0x2a, 
                            "SQ_PERF_SEL_WAIT_IFETCH  :  Number of clock cycles spent waiting for instructions to arrive.
                    {nondeterministic, C1} " = 0x2b, 
                            "SQ_PERF_SEL_WAIT_BARRIER  :  Number of clock cycles spent waiting for a barrier.  In units of cycles.
                    {nondeterministic, C1} " = 0x2c, 
                            "SQ_PERF_SEL_WAIT_EXP_ALLOC  :  Number of clock cycles spent waiting for export allocation.
                    {nondeterministic, C1} " = 0x2d, 
                            "SQ_PERF_SEL_WAIT_SLEEP  :  Number of clock cycles spent waiting for sleep to finish.
                    {nondeterministic, C1} " = 0x2e, 
                            "SQ_PERF_SEL_Reserved_0x02f  :  Reserved. " = 0x2f, 
                            "SQ_PERF_SEL_WAIT_OTHER  :  Number of clock cycles spent waiting for halt, waitcnt, trap, host read,
                    etc.  {nondeterministic, C1} " = 0x30, 
                            "SQ_PERF_SEL_INSTS_ALL  :  Number of all instructions issued. {emulated, C1} " = 0x31, 
                            "SQ_PERF_SEL_INSTS_BRANCH  :  Number of Branch instructions issued. {emulated, C1} " = 0x32, 
                            "SQ_PERF_SEL_INSTS_CBRANCH_NOT_TAKEN  :  Number of Conditional-Branch instructions issued which were not taken. {emulated} " = 0x33, 
                            "SQ_PERF_SEL_INSTS_CBRANCH_TAKEN  :  Number of Conditional-Branch instructions issued which were taken. {emulated} " = 0x34, 
                            "SQ_PERF_SEL_INSTS_CBRANCH_TAKEN_HIT_IS  :  Number of Conditional-Branch instructions issued which were taken and hit in the IS memory. " = 0x35, 
                            "SQ_PERF_SEL_INSTS_EXP_GDS  :  Number of EXP and GDS instructions issued, excluding skipped export
                    instructions.  {emulated, C1} " = 0x36, 
                            "SQ_PERF_SEL_INSTS_GDS  :  Number of GDS instructions issued. {emulated, C1} " = 0x37, 
                            "SQ_PERF_SEL_INSTS_EXP  :  Number of EXP instructions issued, excluding skipped export instructions.
                    {emulated, C1} " = 0x38, 
                            "SQ_PERF_SEL_INSTS_FLAT  :  Number of FLAT instructions issued. {emulated, C2} " = 0x39, 
                            "SQ_PERF_SEL_Reserved_4  :  counter removed " = 0x3a, 
                            "SQ_PERF_SEL_INSTS_LDS  :  Number of LDS indexed instructions issued. {emulated, C1} " = 0x3b, 
                            "SQ_PERF_SEL_INSTS_SALU  :  Number of SALU instructions issued. {emulated, C1} " = 0x3c, 
                            "SQ_PERF_SEL_INSTS_SMEM  :  Number of SMEM instructions issued. {emulated, C1} " = 0x3d, 
                            "SQ_PERF_SEL_INSTS_SMEM_NORM  :  Number of SMEM instructions issued normalized to match smem_level.  It is
                    paired with INST_LEVEL_SMEM.  They both increment by 1, 2 or 4, depending on
                    the SMEM instruction.  cache inv/wb: inc by # of SQC D$ banks (2); atc
                    probe: 0; all others: 2 {emulated} " = 0x3e, 
                            "SQ_PERF_SEL_INSTS_SENDMSG  :  Number of Sendmsg instructions issued. {emulated, C1} " = 0x3f, 
                            "SQ_PERF_SEL_INSTS_VALU  :  Number of VALU instructions issued excluding skipped instructions. {emulated, C1} " = 0x40, 
                            "SQ_PERF_SEL_Reserved_17  :  counter removed " = 0x41, 
                            "SQ_PERF_SEL_INSTS_VALU_TRANS32  :  Number of 32-bit transcendental VALU instructions issued (the type which
                    can be co-executed with main-pipe instructions) excluding skipped instructions.  {emulated} " = 0x42, 
                            "SQ_PERF_SEL_INSTS_VALU_NO_COEXEC  :  Number of VALU instructions issued which can't co-executed in both math pipelines excluding skipped instructions. {emulated} " = 0x43, 
                            "SQ_PERF_SEL_INSTS_TEX  :  Number of image and buffer instructions issued. {emulated, C1} " = 0x44, 
                            "SQ_PERF_SEL_INSTS_TEX_LOAD  :  Number of buffer load, image load, sample, or atomic (with return) instructions issued.  In
                    GEN0/1, counts both loads and stores.  {emulated, C1} " = 0x45, 
                            "SQ_PERF_SEL_INSTS_TEX_STORE  :  Number of buffer store, image store, or atomic (without return)
                    instructions issued.  In GEN0/1, is unused (zero).  {emulated, C1} " = 0x46, 
                            "SQ_PERF_SEL_INSTS_WAVE32  :  Number of wave32 instructions issued, for flat, lds, valu, tex. {emulated, C1} " = 0x47, 
                            "SQ_PERF_SEL_INSTS_WAVE32_FLAT  :  Number of wave32 Flat instructions issued.  Wave64 may count 1 or 2,
                    depending on what gets issued.  {emulated, C2} " = 0x48, 
                            "SQ_PERF_SEL_Reserved_5  :  counter removed " = 0x49, 
                            "SQ_PERF_SEL_INSTS_WAVE32_LDS  :  Number of wave32 LDS indexed instructions issued.  Wave64 may count 1 or 2,
                    depending on what gets issued.  {emulated, C1} " = 0x4a, 
                            "SQ_PERF_SEL_INSTS_WAVE32_VALU  :  Number of wave32 valu instructions issued.  Wave64 may count 1 or 2,
                    depending on what gets issued.  {emulated, C1} " = 0x4b, 
                            "SQ_PERF_SEL_INSTS_WAVE32_EXP_GDS  :  Number of wave32 export and GDS instructions issued.  {emulated, C1} " = 0x4c, 
                            "SQ_PERF_SEL_INSTS_WAVE32_VALU_TRANS32  :  Number of wave32 valu instructions issued using the trans32 pipe only.
                    Wave64 may count 1 or 2, depending on what gets issued.  {emulated} " = 0x4d, 
                            "SQ_PERF_SEL_INSTS_WAVE32_VALU_NO_COEXEC  :  Number of wave32 valu instructions which can't be co-executed in both math
                    pipelines.  Wave64 may count 1 or 2, depending on what gets issued.
                    {emulated} " = 0x4e, 
                            "SQ_PERF_SEL_INSTS_WAVE32_TEX  :  Number of wave32 buffer or image instructions issued.  Wave64 may count 1
                    or 2, depending on what gets issued.  {emulated, C1} " = 0x4f, 
                            "SQ_PERF_SEL_INSTS_WAVE32_TEX_LOAD  :  Number of wave32 buffer load, image load, sample, or atomic (with return) instructions issued.  Wave64 may
                    count 1 or 2, depending on what gets issued.  {emulated} " = 0x50, 
                            "SQ_PERF_SEL_INSTS_WAVE32_TEX_STORE  :  Number of wave32 buffer store, image store, or atomic (without return) instructions issued.
                    Wave64 may count 1 or 2, depending on what gets issued.  {emulated} " = 0x51, 
                            "SQ_PERF_SEL_ITEM_CYCLES_VALU  :  Number of item-cycles used to execute VALU operations (similar to
                    INST_CYCLES_VALU but multiplied by # of active workitems).  {emulated, C1} " = 0x52, 
                            "SQ_PERF_SEL_VALU_READWRITELANE_CYCLES  :  Number of cycles of readlane and writelane instructions issued.  Counts 1
                    for readlane; counts 1 for writelane in wave32, 2 for writelane in wave64.
                    For writelane instruction, count V_WRITELANE_B32 only excluding
                    V_WRITELANE_REGWR_B32 as it only used during debug.  {emulated} " = 0x53, 
                            "SQ_PERF_SEL_WAVE32_INSTS  :  Number of instructions issued by wave32 waves. Skipped instructions are not counted. {emulated} " = 0x54, 
                            "SQ_PERF_SEL_WAVE64_INSTS  :  Number of instructions issued by wave64 waves. Skipped instructions are not counted. {emulated} " = 0x55, 
                            "SQ_PERF_SEL_Reserved_18  :  counter removed " = 0x56, 
                            "SQ_PERF_SEL_INSTS_VALU_EXEC_SKIPPED  :  Number of valu instructions completely skipped (wave32, or both halves of a wave64). {emulated} " = 0x57, 
                            "SQ_PERF_SEL_WAVE64_HALF_SKIP  :  Number of wave64 instructions where half of the instruction was skipped due
                    to EXEC==0 for one half.  Does not count fully skipped instructions
                    {emulated} " = 0x58, 
                            "SQ_PERF_SEL_Reserved_0x059  :  Reserved. " = 0x59, 
                            "SQ_PERF_SEL_Reserved_0x05a  :  Reserved. " = 0x5a, 
                            "SQ_PERF_SEL_Reserved_20  :  counter removed " = 0x5b, 
                            "SQ_PERF_SEL_Reserved_0x05c  :  Reserved. " = 0x5c, 
                            "SQ_PERF_SEL_Reserved_0x05d  :  Reserved. " = 0x5d, 
                            "SQ_PERF_SEL_Reserved_0x05e  :  Reserved. " = 0x5e, 
                            "SQ_PERF_SEL_INSTS_VALU_LDS_DIRECT_RD  :  Number of VALU instructions (in units of wave32's, so wave64 may count
                    twice) that use LDS_DIRECT_RD (not interpolation) excluding skipped instructions.  {emulated, C1} " = 0x5f, 
                            "SQ_PERF_SEL_INSTS_VALU_VINTRP_OP  :  Number of VALU instructions (in units of wave32's, so wave64 may count
                    twice) that use parameter interpolation excluding skipped instructions.  {emulated, C1} " = 0x60, 
                            "SQ_PERF_SEL_INST_LEVEL_EXP  :  Number of in-flight EXP instructions.  Set next counter to ACCUM_PREV and
                    divide by INSTS_EXP for average latency.  {level, nondeterministic, C1} " = 0x61, 
                            "SQ_PERF_SEL_INST_LEVEL_GDS  :  Number of in-flight GDS instructions.  Set next counter to ACCUM_PREV and
                    divide by INSTS_GDS for average latency.  {level, nondeterministic, C1} " = 0x62, 
                            "SQ_PERF_SEL_INST_LEVEL_LDS  :  Number of in-flight LDS instructions.  Set next counter to ACCUM_PREV and
                    divide by INSTS_LDS for average latency.  Includes FLAT instructions.
                    {level, nondeterministic, C1} " = 0x63, 
                            "SQ_PERF_SEL_INST_LEVEL_SMEM  :  Number of in-flight SMEM instructions.  Set next counter to ACCUM_PREV and
                    divide by INSTS_SMEM for average latency per smem request.  Falls slightly
                    short of total request latency because some fetches are divided into two
                    requests that may finish at different times and this counter collects the
                    average latency of the two.  {level, nondeterministic, C1} " = 0x64, 
                            "SQ_PERF_SEL_INST_LEVEL_TEX_LOAD  :  Number of in-flight buffer load, image load, sample, or atomic (with return) instructions.  Set
                    next counter to ACCUM_PREV and divide by INST_TEX_LOAD for average latency.
                    Includes FLAT instructions.  {level, nondeterministic, C2} " = 0x65, 
                            "SQ_PERF_SEL_INST_LEVEL_TEX_STORE  :  Number of in-flight buffer store, image store, or atomic (without
                    return) instructions.  Set next counter to ACCUM_PREV and divide by
                    INSTS_TEX_STORE for average latency.  Includes FLAT instructions.  {level,
                    nondeterministic, C2} " = 0x66, 
                            "SQ_PERF_SEL_IFETCH_REQS  :  Number of instruction fetch requests to SQC cache. {emulated, C1} " = 0x67, 
                            "SQ_PERF_SEL_IFETCH_LEVEL  :  Number of in-flight instruction fetch requests to SQC cache.  Set next
                    counter to ACCUM_PREV and divide by SQ_PERF_SEL_IFETCH_REQS for average
                    latency.  {level, C1} " = 0x68, 
                            "SQ_PERF_SEL_Reserved_0x069  :  Reserved. " = 0x69, 
                            "SQ_PERF_SEL_Reserved_6  :  counter removed " = 0x6a, 
                            "SQ_PERF_SEL_Reserved_7  :  counter removed " = 0x6b, 
                            "SQ_PERF_SEL_LDS_DIRECT_CMD_FIFO_FULL_STALL  :  Number of cycles LDS-direct command from SQ was stalled due to LDS-direct cmd fifo full " = 0x6c, 
                            "SQ_PERF_SEL_VALU_SGATHER_STALL  :  Cycles where SQ SGPR gather stalled for VALU. " = 0x6d, 
                            "SQ_PERF_SEL_VALU_FWD_BUFFER_FULL_STALL  :  Cycles where SQ SGPR gather stalled for VALU due to VALU FWD buffer full " = 0x6e, 
                            "SQ_PERF_SEL_VALU_SGPR_RD_FIFO_FULL_STALL  :  Cycles where SQ SGPR gather stalled for VALU due to an SGPR read FIFO being full " = 0x6f, 
                            "SQ_PERF_SEL_VALU_SGATHER_FULL_STALL  :  Cycles where SQ SGPR gather stalled for VALU due to gatherer stages full " = 0x70, 
                            "SQ_PERF_SEL_SALU_SGATHER_STALL  :  Cycles where SQ SGPR gather stalled for SALU. " = 0x71, 
                            "SQ_PERF_SEL_SALU_SGPR_RD_FIFO_FULL_STALL  :  Cycles where SQ SGPR gather stalled for SALU due to an SGPR read FIFO being full " = 0x72, 
                            "SQ_PERF_SEL_SALU_GATHER_FULL_STALL  :  Cycles where SQ SGPR gather stalled for SALU due to gatherer stages full " = 0x73, 
                            "SQ_PERF_SEL_SMEM_DCACHE_FIFO_FULL_STALL  :  Cycles where arbiter wanted to issue SMEM but couldn't because DCACHE input fifo was full " = 0x74, 
                            "SQ_PERF_SEL_INST_CYCLES_VALU  :  Number of cycles needed to execute VALU operations (SIMD cycles), where
                    there is overlapping V_OP32_1 and V_OP32_T instruction, count them
                    seperately.  {emulated, C1} " = 0x75, 
                            "SQ_PERF_SEL_INST_CYCLES_VALU_TRANS32  :  Number of cycles needed to execute VALU trans32 operations (SIMD cycles). {emulated} " = 0x76, 
                            "SQ_PERF_SEL_INST_CYCLES_VALU_NO_COEXEC  :  Number of cycles which can't co-executed in both math pipelines (SIMD cycles). {emulated} " = 0x77, 
                            "SQ_PERF_SEL_INST_CYCLES_VMEM  :  Number of cycles needed to send addr and data for VMEM (lds, buffer, image,
                    flat, scratch, global) instructions, windowed by perf_en.  {emulated, C1} " = 0x78, 
                            "SQ_PERF_SEL_INST_CYCLES_VMEM_LOAD  :  Number of cycles needed to send addr and data for VMEM loads (lds, buffer,
                    image, flat, scratch, global) instructions.  {emulated, C1} " = 0x79, 
                            "SQ_PERF_SEL_INST_CYCLES_VMEM_STORE  :  Number of cycles needed to send addr and data for VMEM stores & atomics
                    (lds, buffer, image, flat, scratch, global) instructions.  {emulated, C1} " = 0x7a, 
                            "SQ_PERF_SEL_INST_CYCLES_LDS  :  Number of cycles needed to send addr and data for LDS indexed instructions.
                    {emulated, C2} " = 0x7b, 
                            "SQ_PERF_SEL_INST_CYCLES_TEX  :  Number of cycles needed to send addr and data for TEX (buffer, image) instructions. {emulated} " = 0x7c, 
                            "SQ_PERF_SEL_INST_CYCLES_FLAT  :  Number of cycles needed to send addr and data for FLAT (flat, scratch, global) instructions. {emulated} " = 0x7d, 
                            "SQ_PERF_SEL_INST_CYCLES_EXP_GDS  :  Number of cycles needed to export data for EXP and GDS instructions.  It
                    counts the grant cycles from SPI, each instruction could have 1-8 grants.
                    EXP and GDS instruction share the same path and hardware.  {emulated, C2} " = 0x7e, 
                            "SQ_PERF_SEL_INST_CYCLES_EXP  :  Number of cycles needed to export data for EXP instructions. {emulated, C1} " = 0x7f, 
                            "SQ_PERF_SEL_INST_CYCLES_GDS  :  Number of cycles needed to export data for GDS instructions. {emulated, C1} " = 0x80, 
                            "SQ_PERF_SEL_VALU_STARVE  :  Number of cycles VALU is starved while waves are present (cycles in which
                    no sq_sp_cmd credits are in use).  {nondeterministic, C1} " = 0x81, 
                            "SQ_PERF_SEL_VMEM_ARB_FIFO_FULL  :  Number of cycles instruction arbiter was stalled trying to issue a VMEM op
                    but the vmem-arbiter's input fifo was full. " = 0x82, 
                            "SQ_PERF_SEL_MSG_FIFO_FULL_STALL  :  Number of cycles the instruction arbiter was stalled trying to issue a
                    message because SQCs message fifo was full. " = 0x83, 
                            "SQ_PERF_SEL_EXP_REQ_FIFO_FULL  :  Number of cycles the instruction arbiter was stalled from issuing an export
                    request (or GDS) because the export-request buffer was full.  {C1} " = 0x84, 
                            "SQ_PERF_SEL_Reserved_11  :  counter removed " = 0x85, 
                            "SQ_PERF_SEL_Reserved_12  :  counter removed " = 0x86, 
                            "SQ_PERF_SEL_Reserved_13  :  counter removed " = 0x87, 
                            "SQ_PERF_SEL_Reserved_14  :  counter removed " = 0x88, 
                            "SQ_PERF_SEL_VMEM_BUS_ACTIVE  :  Cycles sending address/data to LDS/TA, not windowed by perf_en " = 0x89, 
                            "SQ_PERF_SEL_VMEM_BUS_STALL  :  Cycles stalled from sending address/data to LDS/TA " = 0x8a, 
                            "SQ_PERF_SEL_VMEM_BUS_STALL_TA_ADDR_FIFO_FULL  :  Cycles stalled due to TA addr/data fifo full. {nondeterministic, C1} " = 0x8b, 
                            "SQ_PERF_SEL_VMEM_BUS_STALL_TA_CMD_FIFO_FULL  :  Cycles stalled due to TA cmd fifo full. {nondeterministic, C1} " = 0x8c, 
                            "SQ_PERF_SEL_VMEM_BUS_STALL_LDS_ADDR_FIFO_FULL  :  Cycles stalled due to LDS addr/data fifo full. {nondeterministic, C1} " = 0x8d, 
                            "SQ_PERF_SEL_VMEM_BUS_STALL_LDS_CMD_FIFO_FULL  :  Cycles stalled due to LDS cmd fifo full.  This counter is not functional {nondeterministic, C1} " = 0x8e, 
                            "SQ_PERF_SEL_VMEM_STARVE_TA_ADDR_EMPTY  :  Cycles starved due to TA addr/data fifo empty " = 0x8f, 
                            "SQ_PERF_SEL_VMEM_STARVE_LDS_ADDR_EMPTY  :  Cycles starved due to LDS addr/data fifo empty " = 0x90, 
                            "SQ_PERF_SEL_Reserved_15  :  counter removed " = 0x91, 
                            "SQ_PERF_SEL_SALU_PIPE_STALL  :  Cycles that SALU math pipeline is stalled due to SGPR-write-back. " = 0x92, 
                            "SQ_PERF_SEL_SMEM_DCACHE_RETURN_CYCLES  :  Cycles that SQC-D$ is returning data to SQ " = 0x93, 
                            "SQ_PERF_SEL_Reserved_21  :  counter removed " = 0x94, 
                            "SQ_PERF_SEL_MSG_BUS_BUSY  :  Cycles in which a valid message (other than token) is on the message bus. (measured in SQG) " = 0x95, 
                            "SQ_PERF_SEL_EXP_REQ_BUS_STALL  :  Cycles in which SQ wants to send an export request but is blocked due the bus already being busy. " = 0x96, 
                            "SQ_PERF_SEL_EXP_REQ0_BUS_BUSY  :  Cycles in which export request bus 0 is busy. (measured in SQG) " = 0x97, 
                            "SQ_PERF_SEL_EXP_REQ1_BUS_BUSY  :  Cycles in which export request bus 1 is busy. (measured in SQG) " = 0x98, 
                            "SQ_PERF_SEL_EXP_BUS0_BUSY  :  Cycles in which export data bus is busy (measured in SQG by looking at
                    export grant.  wave64 grant counts for 2) " = 0x99, 
                            "SQ_PERF_SEL_EXP_BUS1_BUSY  :  Cycles in which export data bus is busy (measured in SQG by looking at
                    export grant.  wave64 grant counts for 2) " = 0x9a, 
                            "SQ_PERF_SEL_Reserved_19  :  counter removed " = 0x9b, 
                            "SQ_PERF_SEL_INST_CACHE_REQ_STALL  :  Number of cycles SQ was stalled from making an instruction request due to SQC's input fifo full " = 0x9c, 
                            "SQ_PERF_SEL_Reserved_22  :  counter removed " = 0x9d, 
                            "SQ_PERF_SEL_Reserved_23  :  counter removed " = 0x9e, 
                            "SQ_PERF_SEL_Reserved_24  :  counter removed " = 0x9f, 
                            "SQ_PERF_SEL_USER0  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 0. {emulated, C2} " = 0xa0, 
                            "SQ_PERF_SEL_USER1  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 1. {emulated, C2} " = 0xa1, 
                            "SQ_PERF_SEL_USER2  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 2. {emulated, C2} " = 0xa2, 
                            "SQ_PERF_SEL_USER3  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 3. {emulated, C2} " = 0xa3, 
                            "SQ_PERF_SEL_USER4  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 4. {emulated, C2} " = 0xa4, 
                            "SQ_PERF_SEL_USER5  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 5. {emulated, C2} " = 0xa5, 
                            "SQ_PERF_SEL_USER6  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 6. {emulated, C2} " = 0xa6, 
                            "SQ_PERF_SEL_USER7  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 7. {emulated, C2} " = 0xa7, 
                            "SQ_PERF_SEL_USER8  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 8. {emulated, C2} " = 0xa8, 
                            "SQ_PERF_SEL_USER9  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 9. {emulated, C2} " = 0xa9, 
                            "SQ_PERF_SEL_USER10  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 10. {emulated, C2} " = 0xaa, 
                            "SQ_PERF_SEL_USER11  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 11. {emulated, C2} " = 0xab, 
                            "SQ_PERF_SEL_USER12  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 12. {emulated, C2} " = 0xac, 
                            "SQ_PERF_SEL_USER13  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 13. {emulated, C2} " = 0xad, 
                            "SQ_PERF_SEL_USER14  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 14. {emulated, C2} " = 0xae, 
                            "SQ_PERF_SEL_USER15  :  User counter.  Incremented by S_INCPERFLEVEL when SIMM16[3:0] == 15. {emulated, C2} " = 0xaf, 
                            "SQ_PERF_SEL_USER_LEVEL0  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 0. {level, emulated, C2} " = 0xb0, 
                            "SQ_PERF_SEL_USER_LEVEL1  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 1. {level, emulated, C2} " = 0xb1, 
                            "SQ_PERF_SEL_USER_LEVEL2  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 2. {level, emulated, C2} " = 0xb2, 
                            "SQ_PERF_SEL_USER_LEVEL3  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 3. {level, emulated, C2} " = 0xb3, 
                            "SQ_PERF_SEL_USER_LEVEL4  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 4. {level, emulated, C2} " = 0xb4, 
                            "SQ_PERF_SEL_USER_LEVEL5  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 5. {level, emulated, C2} " = 0xb5, 
                            "SQ_PERF_SEL_USER_LEVEL6  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 6. {level, emulated, C2} " = 0xb6, 
                            "SQ_PERF_SEL_USER_LEVEL7  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 7. {level, emulated, C2} " = 0xb7, 
                            "SQ_PERF_SEL_USER_LEVEL8  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 8. {level, emulated, C2} " = 0xb8, 
                            "SQ_PERF_SEL_USER_LEVEL9  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 9. {level, emulated, C2} " = 0xb9, 
                            "SQ_PERF_SEL_USER_LEVEL10  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 10. {level, emulated, C2} " = 0xba, 
                            "SQ_PERF_SEL_USER_LEVEL11  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 11. {level, emulated, C2} " = 0xbb, 
                            "SQ_PERF_SEL_USER_LEVEL12  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 12. {level, emulated, C2} " = 0xbc, 
                            "SQ_PERF_SEL_USER_LEVEL13  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 13. {level, emulated, C2} " = 0xbd, 
                            "SQ_PERF_SEL_USER_LEVEL14  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 14. {level, emulated, C2} " = 0xbe, 
                            "SQ_PERF_SEL_USER_LEVEL15  :  User level counter.  Incremented by S_INCPERFLEVEL, decremented by S_DECPERFLEVEL when SIMM16[3:0] == 15. {level, emulated, C2} " = 0xbf, 
                            "SQ_PERF_SEL_VALU_RETURN_SDST  :  Count the number of VALU instructions issued which return data to the SQ
                    (EXEC or SGPR/VCC).  This is also
                    equal to the number of dwords sent from SP to SQ. {emulated} " = 0xc0, 
                            "SQ_PERF_SEL_VMEM_VGPR_READ_STALLED_BY_EXPORT  :  Number of times VMEM vgpr read is stalled by export instruction due to bank conflict " = 0xc1, 
                            "SQ_PERF_SEL_INSTS_VALU_TRANS  :  Number transcendental VALU instructions issued {emulated} " = 0xc2, 
                            "SQ_PERF_SEL_DUMMY_END  :  Just a placeholding enum to indicate the end of real SQ performance counter.  Not a real performance counter. " = 0xc3, 
                            "SQ_PERF_SEL_DUMMY_LAST  :  Just a placeholding enum to separate SQ from SQC/SQG counters. Not a real performance counter. " = 0xff }  ;
    DIV2  15:15  NUM ;
    SEL3  23:16  ALPHA {"SQ_PERF_SEL_NONE  :  Don't count anything. Perf counter is disabled. " = 0x0, 
                            "SQ_PERF_SEL_ACCUM_PREV  :  For counter N, increment by the value of counter N-1. " = 0x1, 
                            "SQ_PERF_SEL_CYCLES  :  Total Clock cycles. {nondeterministic, global} " = 0x2, 
                            "SQ_PERF_SEL_BUSY_CYCLES  :  Clock cycles while any SQs in SE reporting busy. {nondeterministic, global, C2} " = 0x3, 
                            "SQ_PERF_SEL_WAVES  :  Count number of waves sent to SQs. {emulated, global, C1} " = 0x4, 
                            "SQ_PERF_SEL_WAVES_32  :  Count number of wave32s sent to SQs. {emulated, global, C1} " = 0x5, 
                            "SQ_PERF_SEL_WAVES_64  :  Count number of waves64s sent to SQs. {emulated, global, C1} " = 0x6, 
                            "SQ_PERF_SEL_LEVEL_WAVES  :  Track the aggregated number of waves over certain period of time, Set next
                    counter to ACCUM_PREV and divide by SQ_PERF_SEL_WAVES for average wave life
                    cycle.  {level, global, C1} " = 0x7, 
                            "SQ_PERF_SEL_ITEMS  :  Number of valid work items in SQs. {emulated, global, C1} " = 0x8, 
                            "SQ_PERF_SEL_WAVE32_ITEMS  :  Number of valid wave32 work items in SQs. {emulated, global, C1} " = 0x9, 
                            "SQ_PERF_SEL_WAVE64_ITEMS  :  Number of valid wave64 work items in SQs. {emulated, global, C1} " = 0xa, 
                            "SQ_PERF_SEL_QUADS  :  Number of completely or partially covered pixel quads in SQs, note: not all
                    kinds of quads.  {emulated, global, C1} " = 0xb, 
                            "SQ_PERF_SEL_EVENTS  :  Number of events sent to SQs.  {unwindowed, emulated, global} " = 0xc, 
                            "SQ_PERF_SEL_WAVES_EQ_64  :  Count number of waves with exactly 64 active items sent to SQs. {emulated, global, C1} " = 0xd, 
                            "SQ_PERF_SEL_WAVES_LT_64  :  Count number of waves with <64 active items sent to SQs. {emulated, global, C1} " = 0xe, 
                            "SQ_PERF_SEL_WAVES_LT_48  :  Count number of waves with <48 active items sent to SQs. {emulated, global, C1} " = 0xf, 
                            "SQ_PERF_SEL_WAVES_LT_32  :  Count number of waves sent <32 active items sent to SQs. {emulated, global, C1} " = 0x10, 
                            "SQ_PERF_SEL_WAVES_LT_16  :  Count number of waves sent <16 active items sent to SQs. {emulated, global, C1} " = 0x11, 
                            "SQ_PERF_SEL_WAVES_RESTORED  :  Count number of context-restored waves sent to SQs. {emulated, global} " = 0x12, 
                            "SQ_PERF_SEL_WAVES_SAVED  :  Count number of context-saved waves sent to SQs. {emulated, global} " = 0x13, 
                            "SQ_PERF_SEL_MSG  :  Number of messages sent, of all types (not including end-program).
                    {nondeterministic, unwindowed, global} " = 0x14, 
                            "SQ_PERF_SEL_MSG_GSCNT  :  Number of GSCNT messages.  {emulated, unwindowed, global} " = 0x15, 
                            "SQ_PERF_SEL_MSG_INTERRUPT  :  Number of interrupt messages.  {emulated, unwindowed, global} " = 0x16, 
                            "SQ_PERF_SEL_Reserved_1  :  counter removed " = 0x17, 
                            "SQ_PERF_SEL_Reserved_2  :  counter removed " = 0x18, 
                            "SQ_PERF_SEL_Reserved_3  :  counter removed " = 0x19, 
                            "SQ_PERF_SEL_WAVE_CYCLES  :  Number of clock cycles spent by waves in the SQs.  Incremented by # of
                    living (valid) waves each cycle.  {nondeterministic, C1} " = 0x1a, 
                            "SQ_PERF_SEL_WAVE_READY  :  Number of clock cycles waves were ready to execute the next instruction.
                    Incremented by # of waves ready to issue an instruction each cycle.  This
                    READY counter will be equal to the sum of: WAIT_INST_* (arb stall) + INST_*
                    (issuing) or INST_WAVE32.  {nondeterministic, C1} " = 0x1b, 
                            "SQ_PERF_SEL_WAIT_INST_ANY  :  Number of clock cycles spent waiting for any instruction issue.  In units
                    of cycles.  {nondeterministic} " = 0x1c, 
                            "SQ_PERF_SEL_WAIT_INST_VALU  :  Number of clock cycles spent waiting for VALU instrution issue.  In units
                    of cycles.  {nondeterministic, C1} " = 0x1d, 
                            "SQ_PERF_SEL_WAIT_INST_SCA  :  Number of clock cycles spent waiting for SALU or SMEM instruction issue.
                    In units of cycles.  {nondeterministic, C1} " = 0x1e, 
                            "SQ_PERF_SEL_WAIT_INST_LDS  :  Number of clock cycles spent waiting for LDS (indexed) instruction issue.
                    In units of cycles.  {nondeterministic, C1} " = 0x1f, 
                            "SQ_PERF_SEL_WAIT_INST_TEX  :  Number of clock cycles spent waiting for TEX (TA) instruction issue.  In
                    units of cycles.  {nondeterministic, C1} " = 0x20, 
                            "SQ_PERF_SEL_WAIT_INST_FLAT  :  Number of clock cycles spent waiting for flat instruction issue.  In units
                    of cycles.  {nondeterministic, C2} " = 0x21, 
                            "SQ_PERF_SEL_WAIT_INST_VMEM  :  Sum of wait_inst_tex + wait_inst_flat + wait_inst_lds {nondeterministic} " = 0x22, 
                            "SQ_PERF_SEL_WAIT_INST_EXP_GDS  :  Number of clock cycles spent waiting for EXPORT or GDS instruction issue.
                    In units of cycles.  {nondeterministic, C1} " = 0x23, 
                            "SQ_PERF_SEL_WAIT_INST_BR_MSG  :  Number of clock cycles spent waiting for BRANCH or SENDMSG instruction
                    issue.  In units of cycles.  {nondeterministic, C1} " = 0x24, 
                            "SQ_PERF_SEL_WAIT_ANY  :  Number of clock cycles spent waiting for anything. {nondeterministic, C1} " = 0x25, 
                            "SQ_PERF_SEL_WAIT_CNT_ANY  :  Number of clock cycles spent waiting for any counter.  In units of cycles.
                    {nondeterministic, C1} " = 0x26, 
                            "SQ_PERF_SEL_WAIT_CNT_VMVS  :  Number of clock cycles spent waiting for VM or VS counter.  In units of
                    cycles.  {nondeterministic, C1} " = 0x27, 
                            "SQ_PERF_SEL_WAIT_CNT_LGKM  :  Number of clock cycles spent waiting for LGKM counter.  In units of cycles.
                    {nondeterministic, C1} " = 0x28, 
                            "SQ_PERF_SEL_WAIT_CNT_EXP  :  Number of clock cycles spent waiting for EXP counter.  In units of cycles.
                    {nondeterministic, C1} " = 0x29, 
                            "SQ_PERF_SEL_WAIT_TTRACE  :  Number of clock cycles spent waiting for thread trace stalls.
                    {nondeterministic, C1} " = 0x2a, 
                            "SQ_PERF_SEL_WAIT_IFETCH  :  Number of clock cycles spent waiting for instructions to arrive.
                    {nondeterministic, C1} " = 0x2b, 
                            "SQ_PERF_SEL_WAIT_BARRIER  :  Number of clock cycles spent waiting for a barrier.  In units of cycles.
                    {nondeterministic, C1} " = 0x2c, 
