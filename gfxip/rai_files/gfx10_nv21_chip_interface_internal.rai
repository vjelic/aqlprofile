                            "SQ_PERF_SEL_INSTS_ALL  :  Number of all instructions issued. {emulated, C1} " = 0x31, 
                            "SQ_PERF_SEL_INSTS_BRANCH  :  Number of Branch instructions issued. {emulated, C1} " = 0x32, 
                            "SQ_PERF_SEL_INSTS_CBRANCH_NOT_TAKEN  :  Number of Conditional-Branch instructions issued which were not taken. {emulated} " = 0x33, 
                            "SQ_PERF_SEL_INSTS_CBRANCH_TAKEN  :  Number of Conditional-Branch instructions issued which were taken. {emulated} " = 0x34, 
                            "SQ_PERF_SEL_INSTS_CBRANCH_TAKEN_HIT_IS  :  Number of Conditional-Branch instructions issued which were taken and hit in the IS memory. " = 0x35, 
                            "SQ_PERF_SEL_INSTS_EXP_GDS  :  Number of EXP and GDS instructions issued, excluding skipped export
                    instructions.  {emulated, C1} " = 0x36, 
                            "SQ_PERF_SEL_INSTS_GDS  :  Number of GDS instructions issued. {emulated, C1} " = 0x37, 
                            "SQ_PERF_SEL_INSTS_EXP  :  Number of EXP instructions issued, excluding skipped export instructions.
                    {emulated, C1} " = 0x38, 
                            "SQ_PERF_SEL_INSTS_FLAT  :  Number of FLAT instructions issued. {emulated, C2} " = 0x39, 
                            "SQ_PERF_SEL_Reserved_4  :  counter removed " = 0x3a, 
                            "SQ_PERF_SEL_INSTS_LDS  :  Number of LDS indexed instructions issued. {emulated, C1} " = 0x3b, 
                            "SQ_PERF_SEL_INSTS_SALU  :  Number of SALU instructions issued. {emulated, C1} " = 0x3c, 
                            "SQ_PERF_SEL_INSTS_SMEM  :  Number of SMEM instructions issued. {emulated, C1} " = 0x3d, 
                            "SQ_PERF_SEL_INSTS_SMEM_NORM  :  Number of SMEM instructions issued normalized to match smem_level.  It is
