CHIP_SPACE GpuF0Reg
{
    TYPE = MM;
    DESCRIPTION  = "Memory Mapped Register Aperture (GPU Function 0)";
    DOC_TOKEN  = "GpuF0MMReg";
    SIZE = 0x80000;
    BASE = BLOCK;
    ALLOCATE = 0x80000;
    TRAP_DEFAULT = DISABLE;
};

