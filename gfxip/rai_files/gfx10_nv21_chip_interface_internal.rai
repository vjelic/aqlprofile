                            "GL2C_PERF_SEL_NOA_REQ  :  Number of NOA requests.  This is measured at the tag block. " = 0x28, 
                            "GL2C_PERF_SEL_SHARED_REQ  :  The number of shared requests(Cacheable & C_R*_S & !IO).  This is measured at the tag block. " = 0x29, 
                            "GL2C_PERF_SEL_HIT  :  Number of cache hits. " = 0x2a, 
                            "GL2C_PERF_SEL_MISS  :  Number of cache misses.  UC reads count as misses. " = 0x2b, 
                            "GL2C_PERF_SEL_FULL_HIT  :  Number of full cache sector hits. " = 0x2c, 
                            "GL2C_PERF_SEL_PARTIAL_32B_HIT  :  Number of 32 byte cache sector hits. This measure excludes a full cache sector hit. " = 0x2d, 
                            "GL2C_PERF_SEL_PARTIAL_64B_HIT  :  Number of 64 byte cache sector hits. This measure excludes a full cache sector hit. " = 0x2e, 
                            "GL2C_PERF_SEL_PARTIAL_96B_HIT  :  Number of 96 byte cache sector hits. This measure excludes a full cache sector hit. " = 0x2f, 
                            "GL2C_PERF_SEL_DEWRITE_ALLOCATE_HIT  :  Number of times a read was performed on a cache line that had only been written into before.  This can only occur once for the life of a cache line. " = 0x30, 
                            "GL2C_PERF_SEL_FULLY_WRITTEN_HIT  :  Number of times a 32-byte read from the EA was avoided because the cache sector was already fully written with data.  This can only occur once for the life of a cache sector. " = 0x31, 
                            "GL2C_PERF_SEL_UNCACHED_WRITE  :  Number of uncached write/atomic requests written back to main memory. " = 0x32, 
