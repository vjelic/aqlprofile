    PERF_SEL  9:0  ALPHA {"PH_PERF_SEL_SC0_SRPS_WINDOW_VALID  :  PH_PERF_SEL_SC0_SRPS_WINDOW_VALID Counts PERFCOUNTER_START to PERFCOUNTER_STOP stop perfcounter enable window in PH Read Setup logic " = 0x0, 
                            "PH_PERF_SEL_SC0_ARB_XFC_ALL_EVENT_OR_PRIM_CYCLES  :  PH_PERF_SEL_SC0_ARB_XFC_ALL_EVENT_OR_PRIM_CYCLES counts number of cycles of arb xfc's for all event or prims " = 0x1, 
                            "PH_PERF_SEL_SC0_ARB_XFC_ONLY_PRIM_CYCLES  :  PH_PERF_SEL_SC0_ARB_XFC_ONLY_PRIM_CYCLES counts number of cycles of arb xfc's for only prims (events excluded) " = 0x2, 
                            "PH_PERF_SEL_SC0_ARB_XFC_ONLY_ONE_INC_PER_PRIM  :  PH_PERF_SEL_SC0_ARB_XFC_ONLY_ONE_INC_PER_PRIM counts number of cycles of arb xfc's for one inc per prim only. Increments only for phase 0 of a multi-cycle primitive transfer " = 0x3, 
                            "PH_PERF_SEL_SC0_ARB_STALLED_FROM_BELOW  :  PH_PERF_SEL_SC0_ARB_STALLED_FROM_BELOW counts number of cycles of stalled post arbiter for valid data " = 0x4, 
                            "PH_PERF_SEL_SC0_ARB_STARVED_FROM_ABOVE  :  PH_PERF_SEL_SC0_ARB_STARVED_FROM_ABOVE counts number of cycles of PA starving SC in start-of-packet/eop range " = 0x5, 
                            "PH_PERF_SEL_SC0_ARB_STARVED_FROM_ABOVE_WITH_UNSELECTED_FIFO_NOT_EMPTY  :  PH_PERF_SEL_SC0_ARB_STARVED_FROM_ABOVE_WITH_UNSELECTED_FIFO_NOT_EMPTY counts from above (pa) with an unselected pa fifo not empty (use if more than one pa only)  " = 0x6, 
                            "PH_PERF_SEL_SC0_ARB_STARVED_FROM_ABOVE_WITH_UNSELECTED_FIFO_FULL  :  PH_PERF_SEL_SC0_ARB_STARVED_FROM_ABOVE_WITH_UNSELECTED_FIFO_FULL counts starved by pa with a unselected pa fifo full (use if more than one pa only) This means that inside the draw packet the SC selected fifo has no valid data, and that one of the unselected fifo's has gone fifo's has gone full. " = 0x7, 
                            "PH_PERF_SEL_SC0_ARB_BUSY  :  PH_PERF_SEL_SC0_ARB_BUSY counts number of cycles of PH_SC0 busy " = 0x8, 
                            "PH_PERF_SEL_SC0_ARB_PA_BUSY_SOP  :  PH_PERF_SEL_SC0_ARB_PA_BUSY_SOP counts number of cycles in between start of packet/end of packet " = 0x9, 
                            "PH_PERF_SEL_SC0_ARB_EOP_POP_SYNC_POP  :  PH_PERF_SEL_SC0_ARB_EOP_POP_SYNC_POP counts number of cycles of of pa sc arbiter eop reads at the eop sync point with all fifos synced " = 0xa, 
                            "PH_PERF_SEL_SC0_ARB_EVENT_SYNC_POP  :  PH_PERF_SEL_SC0_ARB_EVENT_SYNC_POP counts number of cycles of pa sc event reads " = 0xb, 
                            "PH_PERF_SEL_SC0_PS_ENG_MULTICYCLE_BUBBLE  :  PH_PERF_SEL_SC0_PS_ENG_MULTICYCLE_BUBBLE counts number of cycles of multicycles prims sent with a empty fifo slot behind the current phase. " = 0xc, 
                            "PH_PERF_SEL_SC0_EOP_SYNC_WINDOW  :  PH_PERF_SEL_SC0_EOP_SYNC_WINDOW counts number of cycles of after end of packet is read from the selected pa sc fifo until end of packet broadcast synchronization is achieved across all pa sc fifos " = 0xd, 
                            "PH_PERF_SEL_SC0_BUSY_PROCESSING_MULTICYCLE_PRIM  :  PH_PERF_SEL_SC0_BUSY_PROCESSING_MULTICYCLE_PRIM counts number of cycles of sc arbiter busy processing multicycle prims (clipped, perspective linear gradient, line stipple) " = 0xe, 
                            "PH_PERF_SEL_SC0_BUSY_CNT_NOT_ZERO  :  PH_PERF_SEL_SC0_BUSY_CNT_NOT_ZERO counts number of cycles of ph-sc read setup busy counter non zero. " = 0xf, 
                            "PH_PERF_SEL_SC0_SEND  :  PH_PERF_SEL_SC0_SEND counts interface sends to SC " = 0x10, 
                            "PH_PERF_SEL_SC0_CREDIT_AT_ZERO_WITH_PENDING_SEND  :  PH_PERF_SEL_SC0_CREDIT_AT_ZERO_WITH_PENDING_SEND counts interface stalled for no SC credits with pending data available " = 0x11, 
